<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="luna_software_version_view_list" model="ir.ui.view">
        <field name="name">luna.software.version.list</field>
        <field name="model">luna.software.version</field>
        <field name="arch" type="xml">
            <list string="Yazılım Versiyonları" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="luna_software_version_view_form" model="ir.ui.view">
        <field name="name">luna.software.version.form</field>
        <field name="model">luna.software.version</field>
        <field name="arch" type="xml">
            <form string="Yazılım Versiyonu">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="luna_software_version_action" model="ir.actions.act_window">
        <field name="name">Yazılım Versiyonları</field>
        <field name="res_model">luna.software.version</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
