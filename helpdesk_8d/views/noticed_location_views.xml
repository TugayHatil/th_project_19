<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="luna_noticed_location_view_list" model="ir.ui.view">
        <field name="name">luna.noticed.location.list</field>
        <field name="model">luna.noticed.location</field>
        <field name="arch" type="xml">
            <list string="Farkedildiği Yerler" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="luna_noticed_location_view_form" model="ir.ui.view">
        <field name="name">luna.noticed.location.form</field>
        <field name="model">luna.noticed.location</field>
        <field name="arch" type="xml">
            <form string="Farkedildiği Yer">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="luna_noticed_location_action" model="ir.actions.act_window">
        <field name="name">Farkedildiği Yerler</field>
        <field name="res_model">luna.noticed.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
