<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_ltp" model="ir.ui.view">
        <field name="name">product.template.form.ltp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']//group[@name='inventory']" position="inside">
                <group string="Long-Term Planning" name="ltp">
                    <field name="x_long_term_production_planning"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
