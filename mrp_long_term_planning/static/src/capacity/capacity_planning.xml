<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_long_term_planning.CapacityPlanning">
        <div class="o_cap d-flex flex-column h-100 overflow-hidden">

            <!-- Toolbar -->
            <div class="o_cap_toolbar border-bottom px-3 py-2">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h4 class="mb-0">Capacity Planning</h4>
                    <span class="o_cap_period text-muted"
                          t-if="periodText"
                          t-esc="periodText"/>
                </div>
                <div class="d-flex align-items-center gap-3 mt-2 flex-wrap">

                    <!-- multi-select workcenter filter -->
                    <div class="dropdown o_cap_dd">
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-nowrap">Work Center</label>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary dropdown-toggle o_cap_dd_btn"
                                    t-on-click="() => this.toggleMenu('wc')">
                                <span t-esc="workcenterLabel"/>
                            </button>
                        </div>
                        <div class="dropdown-menu show o_cap_dd_menu"
                             t-if="state.wcMenuOpen">
                            <div class="form-check px-3 py-1" t-on-click.stop="clearWorkcenters">
                                <input type="checkbox" class="form-check-input"
                                       t-att-checked="!state.workcenterIds.length"/>
                                <label class="form-check-label">All</label>
                            </div>
                            <div class="dropdown-divider"/>
                            <t t-foreach="state.workcenters" t-as="wc" t-key="wc.id">
                                <div class="form-check px-3 py-1"
                                     t-on-click.stop="() => this.toggleWorkcenter(wc.id)">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="isWorkcenterSelected(wc.id)"/>
                                    <label class="form-check-label" t-esc="wc.name"/>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="form-check">
                        <input id="o_cap_overload_only" type="checkbox"
                               class="form-check-input"
                               t-att-checked="state.overloadOnly"
                               t-on-change="onOverloadOnlyChange"/>
                        <label for="o_cap_overload_only" class="form-check-label text-nowrap">
                            Overload Only
                        </label>
                    </div>

                    <!-- column visibility (MPS-style, BRD §4/§16) -->
                    <div class="dropdown o_cap_dd">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary dropdown-toggle o_cap_dd_btn"
                                t-on-click="() => this.toggleMenu('col')">
                            Columns
                        </button>
                        <div class="dropdown-menu show o_cap_dd_menu"
                             t-if="state.colMenuOpen">
                            <t t-foreach="COLUMNS" t-as="col" t-key="col.key">
                                <div class="form-check px-3 py-1"
                                     t-on-click.stop="() => this.toggleColumn(col.key)">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="state.visible[col.key]"/>
                                    <label class="form-check-label" t-esc="col.label"/>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- display units (BRD §1-§2) -->
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 text-nowrap">Display:</label>
                        <div class="form-check">
                            <input id="o_cap_unit_d" type="checkbox"
                                   class="form-check-input"
                                   t-att-checked="state.showDays"
                                   t-on-change="() => this.toggleUnit('showDays')"/>
                            <label for="o_cap_unit_d" class="form-check-label text-nowrap">Days</label>
                        </div>
                        <div class="form-check">
                            <input id="o_cap_unit_h" type="checkbox"
                                   class="form-check-input"
                                   t-att-checked="state.showHours"
                                   t-on-change="() => this.toggleUnit('showHours')"/>
                            <label for="o_cap_unit_h" class="form-check-label text-nowrap">Hours</label>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 text-nowrap">Start</label>
                        <input type="month" class="form-control form-control-sm"
                               style="width: 140px"
                               t-att-value="state.startPeriod"
                               t-on-change="onStartPeriodChange"/>
                    </div>

                    <input type="text" class="form-control form-control-sm o_cap_search"
                           placeholder="Search work center…"
                           t-on-input="onSearchInput"/>

                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            t-on-click="loadGrid">
                        <i class="fa fa-refresh me-1"/>Refresh
                    </button>
                </div>
            </div>

            <!-- Grid -->
            <div class="o_cap_grid flex-grow-1 overflow-auto position-relative">
                <table class="o_cap_table">
                    <thead>
                        <tr class="o_cap_head_months">
                            <th class="o_cap_sticky o_cap_col_wc" rowspan="2">Work Center / Line</th>
                            <t t-foreach="months" t-as="mo" t-key="mo.key">
                                <th t-att-colspan="colCount"
                                    t-att-class="'o_cap_month_title' + (mo_index % 2 ? ' o_cap_alt' : '')"
                                    t-esc="mo.label"/>
                            </t>
                        </tr>
                        <tr class="o_cap_head_sub">
                            <t t-foreach="months" t-as="mo" t-key="mo.key">
                                <th t-att-class="'o_cap_month_start o_cap_factor_head' + (mo_index % 2 ? ' o_cap_alt' : '')">Factor</th>
                                <t t-foreach="activeCols" t-as="col" t-key="col.key">
                                    <th t-att-class="(col === activeCols[0] ? 'o_cap_month_start ' : '') + (mo_index % 2 ? 'o_cap_alt' : '')"
                                        t-esc="col.label"/>
                                </t>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.rows" t-as="row" t-key="row.workcenter_id">
                            <tr>
                                <td class="o_cap_sticky o_cap_col_wc o_cap_cell_text"
                                    t-esc="row.name"/>
                                <t t-foreach="row.cells" t-as="cell" t-key="cell.year * 100 + cell.month">
                                    <!-- editable monthly capacity factor (BRD §4) -->
                                    <td t-att-class="'o_cap_month_start o_cap_factor' + (cell_index % 2 ? ' o_cap_alt' : '')">
                                        <input t-if="isEditingFactor(row, cell)"
                                               type="text"
                                               class="o_cap_factor_input"
                                               t-ref="factorInput"
                                               t-att-value="state.editValue"
                                               t-on-input="onFactorInput"
                                               t-on-keydown="onFactorKeydown"
                                               t-on-blur="commitFactor"/>
                                        <span t-else=""
                                              t-att-class="'o_cap_factor_val' + (Math.abs((cell.factor || 1) - 1) > 1e-6 ? ' o_cap_factor_mod' : '')"
                                              title="Click to edit the capacity factor"
                                              t-on-click.stop="() => this.startFactorEdit(row, cell)"
                                              t-esc="fmtFactor(cell.factor)"/>
                                    </td>
                                    <t t-foreach="activeCols" t-as="col" t-key="col.key">
                                        <td t-att-class="cellClass(cell, col) + (cell_index % 2 ? ' o_cap_alt' : '')">
                                            <div t-if="state.showDays"
                                                 class="o_cap_days"
                                                 t-esc="cellText(cell, col, 'd')"/>
                                            <div t-if="state.showHours"
                                                 class="o_cap_hours"
                                                 t-esc="cellText(cell, col, 'h')"/>
                                        </td>
                                    </t>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot t-if="state.rows.length">
                        <tr class="o_cap_total">
                            <td class="o_cap_sticky o_cap_col_wc">Total</td>
                            <t t-foreach="totals" t-as="cell" t-key="cell_index">
                                <td t-att-class="'o_cap_month_start o_cap_factor' + (cell_index % 2 ? ' o_cap_alt' : '')"/>
                                <t t-foreach="activeCols" t-as="col" t-key="col.key">
                                    <td t-att-class="cellClass(cell, col) + (cell_index % 2 ? ' o_cap_alt' : '')">
                                        <div t-if="state.showDays"
                                             class="o_cap_days"
                                             t-esc="cellText(cell, col, 'd')"/>
                                        <div t-if="state.showHours"
                                             class="o_cap_hours"
                                             t-esc="cellText(cell, col, 'h')"/>
                                    </td>
                                </t>
                            </t>
                        </tr>
                    </tfoot>
                </table>

                <div t-if="state.loading"
                     class="o_cap_overlay d-flex align-items-center justify-content-center">
                    <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
                </div>
                <div t-if="!state.loading &amp;&amp; !state.rows.length"
                     class="o_cap_empty text-muted text-center py-5">
                    No work centers to show for the current filters.
                </div>
            </div>
        </div>
    </t>
</templates>
