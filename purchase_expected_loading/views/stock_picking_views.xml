<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_expected_loading" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.expected.loading</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='date']" position="after">
                <field name="expected_loading_date" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
