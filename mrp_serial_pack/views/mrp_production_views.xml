<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_serial_pack" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.serial.pack</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_mark_done'][1]" position="before">
                <button name="action_fetch_data" type="object" string="Veri Al"
                        invisible="state not in ('confirmed', 'progress', 'to_close') or product_tracking != 'serial'"
                        data-hotkey="i"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_pack_boxes" type="object"
                        icon="fa-archive" invisible="pack_box_count == 0">
                    <field name="pack_box_count" widget="statinfo" string="Koli"/>
                </button>
                <button class="oe_stat_button" name="action_view_pack_pallets" type="object"
                        icon="fa-cubes" invisible="pack_pallet_count == 0">
                    <field name="pack_pallet_count" widget="statinfo" string="Palet"/>
                </button>
            </xpath>
            <xpath expr="//div[@name='qty']" position="after">
                <label for="pack_transfer_qty" string="Aktarılacak Miktar"
                       invisible="product_tracking != 'serial'"/>
                <div class="o_row" invisible="product_tracking != 'serial'">
                    <field name="pack_transfer_qty" class="oe_inline"
                           placeholder="Boş = planlanan"
                           readonly="state in ('done', 'cancel')"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
