<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_alternative" model="ir.ui.view">
        <field name="name">mrp.production.form.alternative</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_confirm']" position="after">
                <button name="action_open_alternative_selector" type="object"
                        string="Alternatif Seç" icon="fa-random"
                        title="Alternatif malzemeleri değerlendir"
                        invisible="alternative_component_count == 0 or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="alternative_component_count" invisible="True"/>
                <field name="alternative_shortage_count" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list"
                   position="attributes">
                <attribute name="default_order">alt_group_id, id</attribute>
                <attribute name="decoration-muted">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_id']"
                   position="before">
                <field name="alt_marker" string=" " readonly="1" width="24px"
                       decoration-muted="not alt_marker"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list" position="inside">
                <field name="has_bom_alternatives" column_invisible="True"/>
                <field name="alt_group_id" column_invisible="True"/>
                <field name="is_alternative_origin" column_invisible="True"/>
                <field name="original_product_id" string="Original Component"
                       readonly="1" optional="hide"/>
                <field name="is_alternative_component" string="Alt."
                       readonly="1" optional="show"
                       invisible="is_alternative_origin"/>
                <field name="alternative_label" string="Alt. Sıra"
                       readonly="1" optional="show" width="70px"
                       decoration-muted="not alternative_label"/>
                <button name="action_open_alternative_selector" type="object"
                        icon="fa-random" title="Alternatif Malzemeler"
                        invisible="not has_bom_alternatives or is_alternative_origin or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='forecast_availability']"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='quantity']"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_uom']"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_uom'][@widget]"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='location_id']"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='location_dest_id']"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='date']"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='date_deadline']"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='forecast_expected_date']"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_uom_qty']"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_uom_qty'][@widget]"
                   position="attributes">
                <attribute name="invisible">is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/button[@name='action_show_details'][not(@class)]"
                   position="attributes">
                <attribute name="invisible">not show_details_visible or has_tracking == 'none' or is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/button[@name='action_show_details'][@class]"
                   position="attributes">
                <attribute name="invisible">has_tracking != 'none' or not show_details_visible or is_alternative_origin</attribute>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_uom_qty'][last()]"
                   position="after">
                <field name="alternative_original_qty"
                       column_invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>
