<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_orderpoint_tree_inherit_alternative" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.alternative</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_forecast']" position="after">
                <field name="has_bom_alternatives" column_invisible="True"/>
                <button name="action_view_alternatives" type="object"
                        icon="fa-random"
                        title="Alternatif Malzemeleri Görüntüle"
                        invisible="not id or not has_bom_alternatives"/>
            </xpath>
        </field>
    </record>
</odoo>
