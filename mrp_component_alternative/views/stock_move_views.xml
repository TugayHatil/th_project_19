<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_move_list_alternative" model="ir.ui.view">
        <field name="name">stock.move.list.alternative</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list string="Alternatif Bileşen Hareketleri"
                  decoration-muted="state == 'cancel'">
                <field name="raw_material_production_id"
                       string="Üretim Emri"/>
                <field name="production_product_id"
                       string="Üretilen Ürün"/>
                <field name="original_product_id" string="Ana Bileşen"/>
                <field name="product_id" string="Alternatif Bileşen"/>
                <field name="alternative_label" string="Alt. Sıra"/>
                <field name="product_uom_qty" string="İhtiyaç"/>
                <field name="quantity" string="Kullanılan"/>
                <field name="product_uom" string="Birim"
                       groups="uom.group_uom" optional="show"/>
                <field name="alternative_selected_by" string="Seçen"
                       optional="hide"/>
                <field name="alternative_selected_date"
                       string="Seçim Tarihi" optional="hide"/>
                <field name="state" string="Durum" widget="badge"
                       optional="show"/>
            </list>
        </field>
    </record>

    <record id="stock_move_search_alternative" model="ir.ui.view">
        <field name="name">stock.move.search.alternative</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <search string="Alternatif Bileşen Hareketleri">
                <field name="raw_material_production_id"/>
                <field name="production_product_id"/>
                <field name="original_product_id"/>
                <field name="product_id"/>
                <filter name="open_moves" string="Açık"
                        domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <separator/>
                <group>
                    <filter name="group_production" string="Üretim Emri"
                            context="{'group_by': 'raw_material_production_id'}"/>
                    <filter name="group_product" string="Üretilen Ürün"
                            context="{'group_by': 'production_product_id'}"/>
                    <filter name="group_main" string="Ana Bileşen"
                            context="{'group_by': 'original_product_id'}"/>
                    <filter name="group_alt" string="Alternatif Bileşen"
                            context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_alternative_moves" model="ir.actions.act_window">
        <field name="name">Alternatif Bileşen Hareketleri</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_alternative_component', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('stock_move_list_alternative')})]"/>
        <field name="search_view_id" ref="stock_move_search_alternative"/>
    </record>

    <menuitem id="menu_mrp_alternative_moves"
              name="Alternatif Bileşen Hareketleri"
              parent="mrp.menu_mrp_reporting"
              action="mrp_component_alternative.action_mrp_alternative_moves"
              sequence="35"/>
</odoo>
