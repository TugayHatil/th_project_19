<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Alternatif Bileşen Kullanıcısı: allowed to pick/confirm an
         alternative component on a manufacturing order. Implies the
         MRP user rights; MRP users can view alternative definitions. -->
    <record id="group_alternative_selector" model="res.groups">
        <field name="name">Alternatif Bileşen Kullanıcısı</field>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <!-- Alternatif Bileşen Yöneticisi: can create/edit alternative
         definitions on BOM component lines. Also implies the
         selector (user) group so managers can select on MOs too. -->
    <record id="group_alternative_manager" model="res.groups">
        <field name="name">Alternatif Bileşen Yöneticisi</field>
        <field name="implied_ids" eval="[(4, ref('mrp_component_alternative.group_alternative_selector'))]"/>
    </record>

    <!-- Manufacturing managers automatically get both groups. -->
    <record id="mrp.group_mrp_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('mrp_component_alternative.group_alternative_manager'))]"/>
    </record>
</odoo>
