<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_alternative_selector_form" model="ir.ui.view">
        <field name="name">mrp.alternative.selector.form</field>
        <field name="model">mrp.alternative.selector</field>
        <field name="arch" type="xml">
            <form string="Alternatif Malzemeler" class="o_mrp_alternative_selector">
                <sheet>
                    <div class="alert alert-warning d-flex align-items-center"
                         role="alert" invisible="not warning_message">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <field name="warning_message" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="mode" invisible="True"/>
                            <field name="user_can_apply" invisible="True"/>
                            <field name="has_move_lines" invisible="True"/>
                            <field name="production_id" string="Üretim Emri"
                                   readonly="1" invisible="not production_id"
                                   options="{'no_open': True}"/>
                            <field name="orderpoint_id" string="İkmal Kuralı"
                                   readonly="1" invisible="not orderpoint_id"
                                   options="{'no_open': True}"/>
                            <field name="product_id" string="Ana Malzeme"
                                   readonly="1" invisible="not product_id"
                                   options="{'no_open': True}"/>
                        </group>
                        <group>
                            <field name="location_id" string="Konum"
                                   readonly="1" options="{'no_open': True}"/>
                            <field name="demand_qty" string="İhtiyaç"
                                   readonly="1"
                                   invisible="mode != 'orderpoint'"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0"
                              decoration-muted="not is_original and not can_cover"
                              decoration-bf="is_original">
                            <field name="sequence" column_invisible="True"/>
                            <field name="move_id" column_invisible="True"/>
                            <field name="is_original" column_invisible="True"/>
                            <field name="can_cover" column_invisible="True"/>
                            <field name="is_suggested" column_invisible="True"/>
                            <field name="is_current" column_invisible="True"/>
                            <field name="product_id" column_invisible="True"/>
                            <field name="is_folded" column_invisible="True"/>
                            <field name="remembered_selected_id"
                                   column_invisible="True"/>
                            <field name="suggested_label"
                                   column_invisible="True"/>
                            <button name="action_toggle_fold" type="object"
                                    icon="fa-caret-right" title="Alternatifleri Göster"
                                    invisible="not is_original or not move_id or not is_folded or not alt_count"/>
                            <button name="action_toggle_fold" type="object"
                                    icon="fa-caret-down" title="Alternatifleri Gizle"
                                    invisible="not is_original or not move_id or is_folded or not alt_count"/>
                            <field name="component_label" string="Ana Bileşen"
                                   readonly="1"/>
                            <field name="priority" string="Öncelik"
                                   readonly="1"/>
                            <field name="alternative_product_id"
                                   string="Seçenek" readonly="1"
                                   options="{'no_open': True}"/>
                            <field name="demand_qty" string="İhtiyaç"
                                   readonly="1"
                                   invisible="not is_original"/>
                            <field name="available_qty" string="Stok"
                                   readonly="1"/>
                            <field name="uom_id" string="Birim" readonly="1"
                                   groups="uom.group_uom"
                                   options="{'no_open': True}"/>
                            <field name="alt_count" string="Alt."
                                   readonly="1" invisible="not is_original"/>
                            <field name="status_label" string="Durum"
                                   readonly="1" widget="badge"
                                   decoration-success="is_suggested"
                                   decoration-info="is_current and not is_suggested"
                                   decoration-warning="not can_cover"/>
                            <field name="selected" string="Seç"
                                   readonly="not can_cover"
                                   invisible="not can_cover or parent.mode != 'production'"/>
                        </list>
                    </field>
                    <group string="İlişkili Üretim Emri İhtiyaçları"
                           invisible="mode != 'orderpoint' or not has_move_lines">
                        <field name="move_line_ids" nolabel="1">
                            <list create="0" delete="0" edit="0">
                                <field name="production_id" string="Üretim Emri"
                                       readonly="1"/>
                                <field name="move_product_id"
                                       string="Kullanılan Ürün" readonly="1"
                                       options="{'no_open': True}"/>
                                <field name="demand_qty" string="İhtiyaç"
                                       readonly="1"/>
                                <field name="reserved_qty" string="Rezerve"
                                       readonly="1"/>
                                <field name="is_alternative"
                                       string="Alternatif" readonly="1"/>
                                <field name="state" string="Durum"
                                       readonly="1" widget="badge"/>
                            </list>
                        </field>
                    </group>
                    <footer>
                        <button name="action_apply" type="object"
                                class="btn-primary"
                                string="Onayla ve Uygula"
                                confirm="Seçilen alternatifler üretim emrine uygulanacak. Devam edilsin mi?"
                                invisible="mode != 'production' or not user_can_apply"/>
                        <button string="Vazgeç" special="cancel"
                                invisible="mode != 'production'"/>
                        <button string="Kapat" special="cancel"
                                invisible="mode != 'orderpoint'"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
