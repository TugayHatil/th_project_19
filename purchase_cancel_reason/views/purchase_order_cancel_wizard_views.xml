<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_cancel_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.cancel.wizard.form</field>
        <field name="model">purchase.order.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Siparişi İptal Et">
                <group>
                    <field name="order_ids" widget="many2many_tags"
                           options="{'no_open': True}"/>
                    <field name="cancel_reason_id"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="reason_is_other" invisible="1"/>
                    <field name="description" required="reason_is_other"
                           placeholder="İptal nedenini detaylandırınız"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" type="object"
                            string="İptal Et" class="oe_highlight"
                            data-hotkey="q"/>
                    <button string="Vazgeç" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
