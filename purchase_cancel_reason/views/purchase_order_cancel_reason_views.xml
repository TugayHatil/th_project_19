<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_cancel_reason_list" model="ir.ui.view">
        <field name="name">purchase.order.cancel.reason.list</field>
        <field name="model">purchase.order.cancel.reason</field>
        <field name="arch" type="xml">
            <list string="İptal Nedenleri" editable="bottom"
                  decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_other" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="purchase_order_cancel_reason_form" model="ir.ui.view">
        <field name="name">purchase.order.cancel.reason.form</field>
        <field name="model">purchase.order.cancel.reason</field>
        <field name="arch" type="xml">
            <form string="İptal Nedeni">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="is_other"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_order_cancel_reason" model="ir.actions.act_window">
        <field name="name">İptal Nedenleri</field>
        <field name="res_model">purchase.order.cancel.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Henüz iptal nedeni tanımlanmadı.
            </p>
            <p>
                Satınalma siparişleri iptal edilirken seçilebilecek
                nedenler burada tanımlanır. Pasifleştirilen nedenler
                yeni işlemlerde seçilemez ancak geçmiş kayıtlardaki
                bilgi korunur.
            </p>
        </field>
    </record>
</odoo>
