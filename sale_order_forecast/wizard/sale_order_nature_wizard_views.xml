<odoo>
    <data>
        <record id="sale_order_nature_wizard_form" model="ir.ui.view">
            <field name="name">sale.order.nature.wizard.form</field>
            <field name="model">sale.order.nature.wizard</field>
            <field name="arch" type="xml">
                <form string="Sipariş Niteliğini Seçiniz">
                    <field name="order_id" invisible="1"/>
                    <p class="text-center mb-3">
                        Bu siparişin niteliğini belirleyerek onaylama işlemine devam ediniz.
                    </p>
                    <div class="d-flex gap-3 justify-content-center">
                        <button name="action_select_confirmed"
                                string="Kesin"
                                type="object"
                                icon="fa-check"
                                class="btn o_nature_confirmed btn-lg w-50 py-4"
                                title="Müşteri tarafından teyit edilmiş sipariş"/>
                        <button name="action_select_forecast"
                                string="Öngörü"
                                type="object"
                                icon="fa-clock-o"
                                class="btn o_nature_forecast btn-lg w-50 py-4"
                                title="Henüz kesinleşmemiş, planlama amaçlı sipariş"/>
                    </div>
                    <footer/>
                </form>
            </field>
        </record>
    </data>
</odoo>
