<odoo>
    <data>
        <record id="view_order_form_inherit_forecast" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.order.nature</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                    <attribute name="invisible">invoice_status != 'no' or state != 'sale' or order_nature == 'forecast'</attribute>
                </xpath>
                <xpath expr="//header/button[@name='action_cancel']" position="before">
                    <button string="Kesin Siparişe Dönüştür"
                            name="action_convert_to_confirmed"
                            type="object"
                            class="btn-primary"
                            confirm="İşaretlediğiniz satırlar için yeni bir Kesin sipariş oluşturulup onaylanacaktır. Devam etmek istiyor musunuz?"
                            invisible="order_nature != 'forecast' or state != 'sale' or not has_transferable_lines"/>
                </xpath>
                <xpath expr="//group[@name='order_details']/field[@name='payment_term_id']" position="after">
                    <field name="order_nature"
                           readonly="state in ['sale', 'cancel'] or locked or was_confirmed"/>
                    <field name="forecast_converted" invisible="1"/>
                    <field name="was_confirmed" invisible="1"/>
                    <field name="forecast_order_id" invisible="1"/>
                    <field name="confirmed_order_count" invisible="1"/>
                    <field name="has_transferable_lines" invisible="1"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_confirmed_orders" type="object"
                            class="oe_stat_button" icon="fa-check-square-o"
                            invisible="confirmed_order_count == 0">
                        <field name="confirmed_order_count" widget="statinfo"
                               string="Kesin Siparişler"/>
                    </button>
                    <button name="action_view_forecast_source" type="object"
                            class="oe_stat_button" icon="fa-hourglass-half"
                            string="Öngörü Siparişi"
                            invisible="not forecast_order_id"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                    <field name="to_transfer"
                           column_invisible="parent.order_nature != 'forecast'"
                           readonly="display_type or product_uom_qty &lt;= 0"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                    <field name="transfer_qty" string="Aktarım"
                           column_invisible="parent.order_nature != 'forecast'"
                           readonly="not to_transfer"/>
                </xpath>
            </field>
        </record>

        <record id="view_order_tree_inherit_forecast" model="ir.ui.view">
            <field name="name">sale.order.list.inherit.order.nature</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="order_nature" widget="badge" optional="show"
                           decoration-success="order_nature == 'confirmed'"
                           decoration-warning="order_nature == 'forecast'"/>
                </xpath>
            </field>
        </record>

        <record id="view_sales_order_filter_inherit_forecast" model="ir.ui.view">
            <field name="name">sale.order.search.inherit.order.nature</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='order_month']" position="after">
                    <filter name="order_nature" string="Sipariş Niteliği" context="{'group_by': 'order_nature'}"/>
                </xpath>
                <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                    <filter name="confirmed_orders" string="Kesin" domain="[('order_nature', '=', 'confirmed')]"/>
                    <filter name="forecast_orders" string="Öngörü" domain="[('order_nature', '=', 'forecast')]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
