<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_line_paste" model="ir.ui.view">
        <field name="name">purchase.request.form.line.paste</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='product_id']" position="before">
                <control>
                    <create name="add_line_control" string="Satır Ekle"/>
                    <button name="action_open_line_paste_wizard" type="object"
                            string="Satır Yapıştır" class="px-4 btn-link"/>
                </control>
            </xpath>
        </field>
    </record>
</odoo>
