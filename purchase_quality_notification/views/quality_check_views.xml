<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="quality_check_view_form_pqn" model="ir.ui.view">
        <field name="name">quality.check.form.pqn</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='point_id']" position="after">
                <field name="pqn_sent" readonly="1"/>
            </xpath>
            <!-- The standard qty block hides when the check has no move
                 line; detached remainder checks still carry a quantity
                 (pqn_sent_qty via qty_line), so show it in the same
                 left-column spot instead. -->
            <xpath expr="//field[@name='failure_location_id']"
                   position="before">
                <label for="qty_line" invisible="move_line_id"/>
                <div class="o_row" invisible="move_line_id">
                    <field name="qty_line" readonly="1"/>
                    <field name="uom_id" widget="many2one_uom"
                           groups="uom.group_uom"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="quality_check_view_tree_pqn" model="ir.ui.view">
        <field name="name">quality.check.tree.pqn</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quality_state']" position="before">
                <field name="pqn_sent" optional="show"
                       widget="boolean_toggle" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="quality_check_pqn_waiting_list" model="ir.ui.view">
        <field name="name">quality.check.pqn.waiting.list</field>
        <field name="model">quality.check</field>
        <field name="priority" eval="32"/>
        <field name="arch" type="xml">
            <list string="Depoda Onay Bekleyenler">
                <field name="name"/>
                <field name="product_id"/>
                <field name="qty_to_test"/>
                <field name="picking_id"/>
                <field name="point_id" optional="hide"/>
                <field name="control_date" optional="show"/>
                <field name="company_id" optional="hide"
                       groups="base.group_multi_company"/>
                <field name="quality_state" widget="badge"
                       decoration-info="quality_state == 'none'"
                       decoration-success="quality_state == 'pass'"
                       decoration-danger="quality_state == 'fail'"/>
            </list>
        </field>
    </record>

    <record id="quality_check_pqn_waiting_search" model="ir.ui.view">
        <field name="name">quality.check.pqn.waiting.search</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <search string="Depoda Onay Bekleyenler">
                <field name="name"/>
                <field name="product_id"/>
                <field name="picking_id"/>
                <filter name="group_receipt" string="Transfer" domain="[]"
                        context="{'group_by': 'pqn_receipt_label'}"/>
                <filter name="group_product" string="Ürün" domain="[]"
                        context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_pqn_waiting_checks" model="ir.actions.act_window">
        <field name="name">Depoda Onay Bekleyenler</field>
        <field name="res_model">quality.check</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="quality_check_pqn_waiting_list"/>
        <field name="search_view_id" ref="quality_check_pqn_waiting_search"/>
        <field name="domain">[('pqn_sent', '=', True), ('quality_state', '=', 'none')]</field>
        <field name="context">{'group_by': 'pqn_receipt_label'}</field>
    </record>

    <menuitem id="menu_pqn_waiting_checks"
              parent="quality_control.menu_quality_control"
              action="action_pqn_waiting_checks"
              sequence="15"/>

</odoo>
