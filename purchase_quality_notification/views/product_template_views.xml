<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_quality_purchase" model="ir.ui.view">
        <field name="name">product.template.form.quality.purchase</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']/group[@name='purchase']" position="inside">
                <group col="1">
                    <group string="Kalite Kontrol" name="quality_control_purchase">
                        <field name="quality_purchase_ok"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
