<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_form_quality_notify" model="ir.ui.view">
        <field name="name">stock.picking.form.quality.notify</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header//field[@name='state' and @widget='statusbar']" position="before">
                <button name="action_send_quality_notification"
                        string="Kaliteye Gönder" type="object"
                        icon="fa-check" class="oe_highlight"
                        invisible="not show_quality_notify or quality_notified
                                   or not has_quality_send_mark"/>
                <button name="action_send_quality_notification"
                        string="Kaliteye Tekrar Bildir" type="object"
                        icon="fa-check"
                        invisible="not show_quality_notify or not quality_notified
                                   or not has_quality_send_mark"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="show_quality_notify" invisible="1"/>
                <field name="has_quality_send_mark" invisible="1"/>
                <field name="quality_notified" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']"
                   position="after">
                <field name="quality_purchase_ok" column_invisible="True"/>
                <field name="quality_send_ok" string="KK'ya Gönder"
                       readonly="not quality_purchase_ok or state in ('done','cancel')"/>
                <field name="quality_check_state" optional="show"
                       decoration-success="quality_check_state == 'pass'"
                       decoration-warning="quality_check_state == 'not_sent'"
                       decoration-danger="quality_check_state == 'fail'"/>
            </xpath>
        </field>
    </record>

</odoo>
