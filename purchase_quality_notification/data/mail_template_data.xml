<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="mail_template_purchase_quality_notify" model="mail.template">
        <field name="name">Satınalma Kalite Kontrol Bildirimi</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="subject">Kalite Kontrol Talebi – {{ object.name }}</field>
        <field name="description">Gelen transferdeki Satınalma KK kapsamındaki ürünler için kalite ekibine gönderilen bildirim. Alıcılar "Kaliteye Gönder" butonu tarafından Quality / User grubu üyeleri olarak belirlenir.</field>
        <field name="use_default_to" eval="False"/>
        <field name="email_layout_xmlid">mail.mail_notification_light</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html"><![CDATA[
<div>
    <p>Merhaba,</p>
    <p>Tedarikçiden gelen aşağıdaki ürünlerin kalite kontrolünün gerçekleştirilmesi beklenmektedir.</p>
    <ul>
        <li t-if="object.purchase_id"><strong>Satınalma Siparişi:</strong> <t t-out="object.purchase_id.name"/></li>
        <li><strong>Transfer No:</strong> <t t-out="object.name"/></li>
        <li t-if="object.partner_id"><strong>Tedarikçi:</strong> <t t-out="object.partner_id.name"/></li>
    </ul>
    <p><strong>Ürünler:</strong></p>
    <ul>
        <t t-foreach="object.move_ids" t-as="move">
            <li t-if="move.state != 'cancel' and move.product_id.product_tmpl_id.quality_purchase_ok"><t t-out="move.product_id.display_name"/> – <t t-out="'{:g}'.format(move.quantity if object.state == 'done' else move.product_uom_qty)"/> <t t-out="move.product_uom.name"/></li>
        </t>
    </ul>
    <p>İlgili ürünlerin uygunluk kontrollerinin gerçekleştirilmesini rica ederiz.</p>
    <p>İyi çalışmalar.</p>
    <p>
        <a t-att-href="object.quality_picking_url" style="display:inline-block;padding:10px 18px;background-color:#71639e;color:#ffffff;text-decoration:none;border-radius:5px;font-weight:bold;">Transferi Görüntüle</a>
    </p>
</div>
        ]]></field>
    </record>

</odoo>
