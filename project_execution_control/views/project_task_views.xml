<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task form: planned vs actual side by side (BRD §4.2). The actual
         entry pair is editable; everything derived stays readonly. -->
    <record id="project_task_form_inherit_actual" model="ir.ui.view">
        <field name="name">project.task.form.inherit.actual</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="actual_tracking" string="Actual">
                    <group>
                        <group string="Planned">
                            <field name="date_assign" readonly="1"/>
                            <field name="date_deadline" readonly="1"/>
                            <field name="allocated_hours" widget="float_time" readonly="1"/>
                            <field name="effective_hours" widget="float_time" readonly="1"/>
                            <field name="progress" widget="progressbar" readonly="1"/>
                        </group>
                        <group string="Actual">
                            <field name="date_actual_start"/>
                            <field name="date_actual_end"/>
                            <field name="actual_finish" readonly="1"/>
                            <field name="actual_duration" widget="float_time" readonly="1"/>
                            <field name="actual_status" widget="badge"
                                   decoration-success="actual_status == 'done'"
                                   decoration-warning="actual_status == 'in_progress'"
                                   decoration-info="actual_status == 'not_started'"/>
                        </group>
                    </group>
                    <group string="Schedule Variance">
                        <group>
                            <field name="schedule_variance_days" readonly="1"/>
                            <field name="schedule_variance_state" widget="badge"
                                   decoration-danger="schedule_variance_state == 'late'"
                                   decoration-success="schedule_variance_state == 'early'"
                                   decoration-info="schedule_variance_state == 'on_time'"/>
                        </group>
                        <group>
                            <field name="finish_variance_state" widget="badge"
                                   decoration-danger="finish_variance_state == 'late'"
                                   decoration-success="finish_variance_state == 'early'"
                                   decoration-info="finish_variance_state == 'on_time'"/>
                            <field name="date_done" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_task_list_inherit_actual" model="ir.ui.view">
        <field name="name">project.task.list.inherit.actual</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="date_actual_start" optional="hide"/>
                <field name="actual_finish" optional="hide"/>
                <field name="actual_status" widget="badge" optional="show"
                       decoration-success="actual_status == 'done'"
                       decoration-warning="actual_status == 'in_progress'"
                       decoration-info="actual_status == 'not_started'"/>
                <field name="schedule_variance_days" optional="hide"/>
                <field name="schedule_variance_state" widget="badge" optional="hide"
                       decoration-danger="schedule_variance_state == 'late'"
                       decoration-success="schedule_variance_state == 'early'"
                       decoration-info="schedule_variance_state == 'on_time'"/>
            </xpath>
        </field>
    </record>

    <!-- Actual-status filters on the standard task search. -->
    <record id="project_task_search_inherit_actual" model="ir.ui.view">
        <field name="name">project.task.search.inherit.actual</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="date_actual_start"/>
                <field name="actual_finish"/>
            </xpath>
            <xpath expr="//group" position="before">
                <filter name="filter_actual_in_progress" string="In Progress (Actual)"
                        domain="[('actual_status', '=', 'in_progress')]"/>
                <filter name="filter_actual_not_started" string="Not Started (Actual)"
                        domain="[('actual_status', '=', 'not_started')]"/>
                <filter name="filter_variance_late" string="Finished Late"
                        domain="[('schedule_variance_state', '=', 'late')]"/>
                <filter name="filter_variance_early" string="Finished Early"
                        domain="[('schedule_variance_state', '=', 'early')]"/>
                <filter name="filter_variance_on_time" string="Finished On Time"
                        domain="[('schedule_variance_state', '=', 'on_time')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_by_actual_status" string="Actual Status"
                        context="{'group_by': 'actual_status'}"/>
                <filter name="group_by_schedule_variance" string="Schedule Variance"
                        context="{'group_by': 'schedule_variance_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- Same filter set inside the Planner workspace search bar. -->
    <record id="project_task_planner_search_inherit_actual" model="ir.ui.view">
        <field name="name">project.task.planner.search.inherit.actual</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_critical_path.project_task_planner_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="date_actual_start"/>
                <field name="actual_finish"/>
            </xpath>
            <xpath expr="//filter[@name='filter_completed']" position="after">
                <filter name="filter_actual_in_progress" string="In Progress (Actual)"
                        domain="[('actual_status', '=', 'in_progress')]"/>
                <filter name="filter_actual_not_started" string="Not Started (Actual)"
                        domain="[('actual_status', '=', 'not_started')]"/>
                <separator/>
                <filter name="filter_variance_late" string="Finished Late"
                        domain="[('schedule_variance_state', '=', 'late')]"/>
                <filter name="filter_variance_early" string="Finished Early"
                        domain="[('schedule_variance_state', '=', 'early')]"/>
                <filter name="filter_variance_on_time" string="Finished On Time"
                        domain="[('schedule_variance_state', '=', 'on_time')]"/>
            </xpath>
            <xpath expr="//filter[@name='group_wbs_level']" position="after">
                <filter name="group_by_actual_status" string="Actual Status"
                        context="{'group_by': 'actual_status'}"/>
            </xpath>
        </field>
    </record>
</odoo>
