<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         Phase 3 — Skill / Resource Matching (BRD §7)
         Coverage analysis on top of hr_skills + the resource-planning
         assignments. Read-only: nothing here assigns or schedules.
         ════════════════════════════════════════════════════════════════ -->

    <!-- Task form: Skill block inside the Resource Requirements page —
         the planning concepts already live there. -->
    <record id="project_task_form_inherit_skills" model="ir.ui.view">
        <field name="name">project.task.form.inherit.skills</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_resource_planning.project_task_form_inherit_resource_requirements"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='resource_requirements']/field[@name='resource_requirement_ids']"
                   position="after">
                <group string="Skill Match">
                    <group>
                        <field name="skill_match_state" widget="badge" readonly="1"
                               decoration-success="skill_match_state == 'matched'"
                               decoration-warning="skill_match_state == 'partial'"
                               decoration-danger="skill_match_state == 'unmatched'"
                               decoration-info="skill_match_state == 'not_required'"/>
                        <field name="skill_match_percentage" widget="progressbar" readonly="1"/>
                        <field name="skill_match_detail" readonly="1"
                               invisible="not skill_match_detail"/>
                    </group>
                    <group>
                        <field name="skill_required_count" readonly="1"/>
                        <field name="skill_matched_count" readonly="1"/>
                        <field name="skill_missing_count" readonly="1"/>
                    </group>
                </group>
                <field name="skill_requirement_ids" nolabel="1"
                       context="{'default_task_id': id}">
                    <list editable="bottom" string="Skill Requirements">
                        <field name="sequence" widget="handle"/>
                        <field name="skill_id"/>
                        <field name="required_level_id"/>
                        <field name="is_optional" widget="boolean_toggle"/>
                        <field name="coverage_state" widget="badge" readonly="1"
                               decoration-success="coverage_state == 'matched'"
                               decoration-warning="coverage_state == 'partial'"
                               decoration-danger="coverage_state == 'missing'"/>
                        <field name="best_progress" readonly="1" optional="hide"/>
                        <field name="covered_by" readonly="1" optional="hide"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <!-- Task list: match badge (optional). -->
    <record id="project_task_list_inherit_skills" model="ir.ui.view">
        <field name="name">project.task.list.inherit.skills</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_execution_control.project_task_list_inherit_material"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='material_risk']" position="after">
                <field name="skill_match_state" widget="badge" optional="show"
                       decoration-success="skill_match_state == 'matched'"
                       decoration-warning="skill_match_state == 'partial'"
                       decoration-danger="skill_match_state == 'unmatched'"
                       decoration-info="skill_match_state == 'not_required'"/>
            </xpath>
        </field>
    </record>

    <!-- Skill-match filters on the standard task search. -->
    <record id="project_task_search_inherit_skills" model="ir.ui.view">
        <field name="name">project.task.search.inherit.skills</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <filter name="filter_skill_required" string="Skill Required"
                        domain="[('skill_match_state', '!=', 'not_required')]"/>
                <filter name="filter_skill_matched" string="Skill Matched"
                        domain="[('skill_match_state', '=', 'matched')]"/>
                <filter name="filter_skill_partial" string="Partial Skill Match"
                        domain="[('skill_match_state', '=', 'partial')]"/>
                <filter name="filter_skill_unmatched" string="Skill Unmatched"
                        domain="[('skill_match_state', '=', 'unmatched')]"/>
            </xpath>
        </field>
    </record>

    <!-- Same filters inside the Planner workspace search bar. -->
    <record id="project_task_planner_search_inherit_skills" model="ir.ui.view">
        <field name="name">project.task.planner.search.inherit.skills</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_execution_control.project_task_planner_search_inherit_material"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_material_critical']" position="after">
                <separator/>
                <filter name="filter_skill_required" string="Skill Required"
                        domain="[('skill_match_state', '!=', 'not_required')]"/>
                <filter name="filter_skill_matched" string="Skill Matched"
                        domain="[('skill_match_state', '=', 'matched')]"/>
                <filter name="filter_skill_partial" string="Partial Skill Match"
                        domain="[('skill_match_state', '=', 'partial')]"/>
                <filter name="filter_skill_unmatched" string="Skill Unmatched"
                        domain="[('skill_match_state', '=', 'unmatched')]"/>
            </xpath>
        </field>
    </record>

    <!-- Project Control: Skill block with the four KPI counters. -->
    <record id="project_project_form_inherit_skills" model="ir.ui.view">
        <field name="name">project.project.form.inherit.skills</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_execution_control.project_project_form_inherit_control"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='project_control']/group[last()]"
                   position="after">
                <group string="Skills">
                    <group>
                        <field name="skill_required_task_count" readonly="1"/>
                        <field name="skill_matched_task_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="skill_partial_task_count" readonly="1"/>
                        <field name="skill_unmatched_task_count" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
