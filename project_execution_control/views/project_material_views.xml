<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         Phase 2 — Material Delay & Impact (BRD §6/§7/§24)
         Line availability columns, task-level risk block and the
         project-finish projection. All read-only: the projection must
         never write back to plan, actuals or baselines.
         ════════════════════════════════════════════════════════════════ -->

    <!-- Task form: Material page next to Actual. The line list is the
         requirement itself (project.material.plan rows); the header
         block carries the aggregated risk and the impact projection. -->
    <record id="project_task_form_inherit_material" model="ir.ui.view">
        <field name="name">project.task.form.inherit.material</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_execution_control.project_task_form_inherit_actual"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='actual_tracking']" position="after">
                <page name="material_tracking" string="Material">
                    <group>
                        <group string="Material Risk">
                            <field name="material_risk" widget="badge" readonly="1"
                                   decoration-danger="material_risk in ('delayed', 'critical')"
                                   decoration-warning="material_risk == 'partial'"
                                   decoration-success="material_risk == 'no_risk'"/>
                            <field name="material_delay_days" readonly="1"/>
                            <field name="material_expected_delay_days" readonly="1"/>
                            <field name="material_shortage_quantity" readonly="1"
                                   invisible="not material_shortage_quantity"/>
                        </group>
                        <group string="Impact Projection">
                            <field name="material_downstream_count" readonly="1"/>
                            <field name="material_downstream_impact_days" readonly="1"/>
                            <field name="material_project_impact_days" readonly="1"/>
                            <field name="material_risk_detail" readonly="1"
                                   invisible="not material_risk_detail"/>
                        </group>
                    </group>
                    <field name="material_plan_line_ids" readonly="1">
                        <list string="Material Requirements">
                            <field name="product_id"/>
                            <field name="planned_quantity"/>
                            <field name="uom_id"/>
                            <field name="required_date"/>
                            <field name="available_quantity"/>
                            <field name="shortage_quantity"/>
                            <field name="expected_availability_date"/>
                            <field name="material_delay_days"/>
                            <field name="material_state" widget="badge"
                                   decoration-success="material_state == 'ready'"
                                   decoration-warning="material_state == 'partial'"
                                   decoration-danger="material_state == 'delayed'"
                                   decoration-info="material_state == 'unknown'"/>
                            <field name="state" widget="badge"
                                   decoration-warning="state == 'draft'"
                                   decoration-success="state == 'approved'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Task list: risk badge + delay column (optional). Inherits our
         own Phase-1 extension so the actual_status anchor exists. -->
    <record id="project_task_list_inherit_material" model="ir.ui.view">
        <field name="name">project.task.list.inherit.material</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_execution_control.project_task_list_inherit_actual"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='actual_status']" position="after">
                <field name="material_risk" widget="badge" optional="show"
                       decoration-danger="material_risk in ('delayed', 'critical')"
                       decoration-warning="material_risk == 'partial'"
                       decoration-success="material_risk == 'no_risk'"/>
                <field name="material_delay_days" optional="hide"/>
                <field name="material_project_impact_days" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Material-risk filters on the standard task search. -->
    <record id="project_task_search_inherit_material" model="ir.ui.view">
        <field name="name">project.task.search.inherit.material</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <filter name="filter_material_risk" string="Material Risk"
                        domain="[('material_risk', '!=', 'no_risk')]"/>
                <filter name="filter_material_delayed" string="Material Delayed"
                        domain="[('material_risk', 'in', ('delayed', 'critical'))]"/>
                <filter name="filter_material_critical" string="Critical Material Delay"
                        domain="[('material_risk', '=', 'critical')]"/>
            </xpath>
        </field>
    </record>

    <!-- Same filters inside the Planner workspace search bar. -->
    <record id="project_task_planner_search_inherit_material" model="ir.ui.view">
        <field name="name">project.task.planner.search.inherit.material</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_execution_control.project_task_planner_search_inherit_actual"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_variance_on_time']" position="after">
                <separator/>
                <filter name="filter_material_risk" string="Material Risk"
                        domain="[('material_risk', '!=', 'no_risk')]"/>
                <filter name="filter_material_delayed" string="Material Delayed"
                        domain="[('material_risk', 'in', ('delayed', 'critical'))]"/>
                <filter name="filter_material_critical" string="Critical Material Delay"
                        domain="[('material_risk', '=', 'critical')]"/>
            </xpath>
        </field>
    </record>

    <!-- Material plan list: availability read-out columns. -->
    <record id="project_material_plan_list_inherit_availability" model="ir.ui.view">
        <field name="name">project.material.plan.list.inherit.availability</field>
        <field name="model">project.material.plan</field>
        <field name="inherit_id" ref="project_resource_planning.project_material_plan_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='required_date']" position="after">
                <field name="available_quantity" readonly="1"/>
                <field name="shortage_quantity" readonly="1"/>
                <field name="expected_availability_date" readonly="1"/>
                <field name="material_delay_days" readonly="1" optional="hide"/>
                <field name="material_state" widget="badge" readonly="1"
                       decoration-success="material_state == 'ready'"
                       decoration-warning="material_state == 'partial'"
                       decoration-danger="material_state == 'delayed'"
                       decoration-info="material_state == 'unknown'"/>
            </xpath>
        </field>
    </record>

    <!-- Material plan form: availability block under the quantities. -->
    <record id="project_material_plan_form_inherit_availability" model="ir.ui.view">
        <field name="name">project.material.plan.form.inherit.availability</field>
        <field name="model">project.material.plan</field>
        <field name="inherit_id" ref="project_resource_planning.project_material_plan_form"/>
        <field name="arch" type="xml">
            <!-- String selectors are banned in view inheritance — anchor
                 on the notebook, which follows the Stock Transfer group. -->
            <xpath expr="//notebook" position="before">
                <group string="Availability">
                    <group>
                        <field name="available_quantity" readonly="1"/>
                        <field name="shortage_quantity" readonly="1"/>
                        <field name="material_state" widget="badge" readonly="1"
                               decoration-success="material_state == 'ready'"
                               decoration-warning="material_state == 'partial'"
                               decoration-danger="material_state == 'delayed'"
                               decoration-info="material_state == 'unknown'"/>
                    </group>
                    <group>
                        <field name="expected_availability_date" readonly="1"/>
                        <field name="material_delay_days" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Material plan search: availability-state filters + grouping. -->
    <record id="project_material_plan_search_inherit_availability" model="ir.ui.view">
        <field name="name">project.material.plan.search.inherit.availability</field>
        <field name="model">project.material.plan</field>
        <field name="inherit_id" ref="project_resource_planning.project_material_plan_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_required_passed']" position="after">
                <filter name="filter_material_at_risk" string="At Risk"
                        domain="[('material_state', 'in', ('partial', 'delayed', 'unknown'))]"/>
                <filter name="filter_material_delayed" string="Delayed"
                        domain="[('material_state', '=', 'delayed')]"/>
                <filter name="filter_material_unconfirmed" string="Unconfirmed"
                        domain="[('material_state', '=', 'unknown')]"/>
            </xpath>
            <xpath expr="//filter[@name='group_state']" position="after">
                <filter name="group_material_state" string="Material Status"
                        context="{'group_by': 'material_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- Project Control: Material block — counts plus the read-only
         planned-vs-projected finish pair (BRD §6.6/§24). -->
    <record id="project_project_form_inherit_material" model="ir.ui.view">
        <field name="name">project.project.form.inherit.material</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_execution_control.project_project_form_inherit_control"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='project_control']/group[last()]"
                   position="after">
                <group string="Material">
                    <group>
                        <field name="material_risk_task_count" readonly="1"/>
                        <field name="material_delayed_task_count" readonly="1"/>
                        <field name="material_critical_delay_task_count" readonly="1"/>
                        <field name="material_shortage_line_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="material_planned_finish" readonly="1"/>
                        <field name="material_projected_finish" readonly="1"/>
                        <field name="material_finish_impact_days" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
