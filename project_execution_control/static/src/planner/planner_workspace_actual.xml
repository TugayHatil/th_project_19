<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Actual bar (BRD §4.7): a thin strip at the top of each planner row,
         drawn only when actual data exists. Extends the core template in
         place — the plan bar, baseline ghost and finish tail keep their
         exact markup and behaviour. -->
    <t t-name="project_execution_control.PlannerWorkspaceActual"
       t-inherit="project_critical_path.PlannerWorkspace" t-inherit-mode="extension">
        <xpath expr="//div[@class='o_cp_planner_bar']" position="after">
            <div t-if="row.task.actual_start"
                 class="o_pec_actual_bar"
                 t-att-class="actualBarClass(row.task)"
                 t-att-style="actualBarStyle(row.task)"
                 t-att-title="actualBarTooltip(row.task)"/>
        </xpath>
        <!-- Material-risk dot (BRD §6.4): sits right of the task name,
             colours follow the same traffic-light vocabulary as the
             status badges. Absent entirely when the task has no material
             requirement or no risk. -->
        <xpath expr="//span[@class='o_cp_planner_task_name text-truncate']"
               position="after">
            <span t-if="row.task.material_risk and row.task.material_risk !== 'no_risk'"
                  t-att-class="'o_pec_material_dot ' + row.task.material_risk"
                  t-att-title="materialRiskTooltip(row.task)"/>
            <!-- Skill-match dot (Phase 3, BRD §7): same micro-badge
                 family. Absent when the task needs no skills. -->
            <span t-if="row.task.skill_match_state and row.task.skill_match_state !== 'not_required'"
                  t-att-class="'o_pec_skill_dot ' + row.task.skill_match_state"
                  t-att-title="skillMatchTooltip(row.task)"/>
        </xpath>
    </t>
</templates>
