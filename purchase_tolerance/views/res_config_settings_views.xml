<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_tolerance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.tolerance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="purchase_tolerance_setting"
                         title="Satınalma Toleransı"
                         help="Tedarikçinin sipariş edilen miktardan fazla teslimat yapabileceği varsayılan yüzde tolerans. Ürün veya sipariş satırında özel tolerans tanımlanabilir.">
                    <field name="purchase_tolerance"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
