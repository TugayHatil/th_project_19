<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_tolerance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.tolerance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="purchase_tolerance_setting"
                         title="Satınalma Toleransı"
                         help="Tedarikçinin sipariş edilen miktardan fazla teslimat yapabileceği varsayılan yüzde tolerans. Ürün veya sipariş satırında özel tolerans tanımlanabilir.">
                    <field name="purchase_tolerance"/>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_stock_tolerance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.tolerance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='operations_setting_container']" position="inside">
                <setting id="tolerance_excess_location_setting"
                         title="Tolerans Dışı Miktar Konumu"
                         help="Koşullu onaylanan tolerans taleplerinde, onaylanan miktarın üzerindeki tolerans dışı miktar bu konuma alınır ve buradan tedarikçiye iade transferi oluşturulur.">
                    <field name="tolerance_excess_location_id"
                           options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
