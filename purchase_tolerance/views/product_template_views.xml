<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_purchase_tolerance" model="ir.ui.view">
        <field name="name">product.template.form.inherit.purchase.tolerance</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='purchase']" position="inside">
                <group col="1">
                    <group string="Satınalma Toleransı">
                        <field name="purchase_tolerance"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
