<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MİP number sequence: numbers are never reused (BRD §4.1) -->
    <record id="seq_mip_need_line" model="ir.sequence">
        <field name="name">MİP İhtiyaç Kaydı</field>
        <field name="code">mip.need.line</field>
        <field name="prefix" eval="False"/>
        <field name="padding">10</field>
        <field name="number_next">0</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Nightly sweep: register needs appearing outside the active
         screen and settle records whose moves finished or were
         cancelled (BRD §4.3) -->
    <record id="ir_cron_mip_need_line_sync" model="ir.cron">
        <field name="name">MİP: ihtiyaç kayıtlarını senkronize et</field>
        <field name="model_id" ref="model_mip_need_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Plan warm-up: rebuilds the persisted plan snapshot whenever the
         plan version moved, so user requests are served from the
         snapshot instead of a synchronous build -->
    <record id="ir_cron_plan_warmup" model="ir.cron">
        <field name="name">MİP: plan önbelleğini sıcak tut</field>
        <field name="model_id" ref="model_mrp_purchase_need"/>
        <field name="state">code</field>
        <field name="code">model._cron_plan_warmup()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
