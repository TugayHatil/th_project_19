<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_need" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.need</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="purchase_need_process_days_setting"
                         string="Satınalma için Gerekli Gün"
                         help="Ürün kartında değer tanımlanmamışsa Malzeme İhtiyaç Planlama ekranının kullandığı varsayılan iç satınalma süresi (gün).">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="purchase_need_process_days"
                                   string="Varsayılan Gün"
                                   class="col-3 col-lg-3 o_light_label"/>
                            <field name="purchase_need_process_days" class="w-25"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
