<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_purchase_need" model="ir.ui.view">
        <field name="name">product.template.form.purchase.need</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']/group[@name='purchase']" position="inside">
                <group string="Material Need Planning" name="purchase_need_plan">
                    <field name="x_purchase_process_days"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
