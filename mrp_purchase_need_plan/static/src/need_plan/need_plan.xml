<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_purchase_need_plan.NeedPlan">
        <div class="o_mnp d-flex flex-column h-100 overflow-hidden">

            <!-- Araç çubuğu -->
            <div class="o_mnp_toolbar border-bottom px-3 py-2">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h4 class="mb-0">Malzeme İhtiyaç Planlama</h4>
                    <button type="button" class="btn btn-sm btn-primary"
                            t-att-disabled="!state.canCreate or !selectedCount or state.creating"
                            t-on-click="onCreateRequest">
                        <i class="fa fa-shopping-cart me-1"/>Seçilen İhtiyaçlar İçin Satınalma Talebi Oluştur
                        <t t-if="selectedCount"> (<t t-esc="selectedCount"/>)</t>
                    </button>
                </div>
                <div class="d-flex align-items-center gap-3 mt-2 flex-wrap">
                    <div class="o_mnp_searchbar">
                        <div class="o_mnp_searchbox">
                            <t t-foreach="state.queries" t-as="term"
                               t-key="term_index">
                                <span class="o_mnp_facet">
                                    <i class="fa fa-search me-1"/>
                                    Ürün: <t t-esc="term"/>
                                    <button type="button" class="o_mnp_facet_clear"
                                            title="Aramayı kaldır"
                                            t-on-click="() => this.removeQuery(term_index)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </span>
                            </t>
                            <t t-if="state.focusProductId">
                                <span class="o_mnp_facet o_mnp_facet_focus"
                                      title="Sadece bu ürünün reçetesindeki komponentler gösteriliyor">
                                    <i class="fa fa-sitemap me-1"/>
                                    Odak: <t t-esc="state.focusProductName"/>
                                    <button type="button" class="o_mnp_facet_clear"
                                            title="Odağı kaldır"
                                            t-on-click="clearFocus">
                                        <i class="fa fa-times"/>
                                    </button>
                                </span>
                            </t>
                            <input type="text" class="o_mnp_searchinput"
                                   placeholder="Ara…"
                                   t-att-value="state.searchText"
                                   t-on-input="onSearchbarInput"
                                   t-on-keydown="onSearchKeydown"/>
                            <i class="fa fa-search o_mnp_searchicon"/>
                        </div>
                        <t t-if="state.searchOpen and state.searchText">
                            <div class="o_mnp_searchmenu">
                                <div t-att-class="'o_mnp_searchitem' + (state.activeIndex === 0 ? ' o_mnp_active' : '')"
                                     t-on-click="applyProductSearch">
                                    Arama <b>Ürün</b> için:
                                    <t t-esc="state.searchText"/>
                                </div>
                                <div t-att-class="'o_mnp_searchitem o_mnp_searchgroup' + (state.activeIndex === 1 ? ' o_mnp_active' : '')"
                                     t-on-click="toggleFocusGroup">
                                    <i t-att-class="'fa me-1 ' + (state.focusExpanded ? 'fa-caret-down' : 'fa-caret-right')"/>
                                    Arama <b>Odak (Reçete)</b> için:
                                    <t t-esc="state.searchText"/>
                                </div>
                                <t t-if="state.focusExpanded">
                                    <div t-foreach="state.focusResults" t-as="prod"
                                         t-key="prod.id"
                                         t-att-class="'o_mnp_searchitem o_mnp_searchsub' + (state.activeIndex === prod_index + 2 ? ' o_mnp_active' : '')"
                                         t-on-click="() => this.selectFocus(prod)"
                                         t-esc="prod.name"/>
                                    <div t-if="!state.focusResults.length"
                                         class="o_mnp_searchitem o_mnp_searchsub text-muted">
                                        (sonuç yok)
                                    </div>
                                </t>
                            </div>
                            <div class="o_mnp_focus_backdrop"
                                 t-on-click="closeSearchMenu"/>
                        </t>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 text-nowrap">Depo</label>
                        <select class="form-select form-select-sm w-auto"
                                t-on-change="onWarehouseChange">
                            <option value="">Tümü</option>
                            <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                                <option t-att-value="wh.id"
                                        t-att-selected="wh.id === state.warehouseId"
                                        t-esc="`${wh.name} (${wh.code})`"/>
                            </t>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 text-nowrap">İhtiyaç tarihi</label>
                        <input type="date" class="form-control form-control-sm w-auto"
                               t-att-value="state.dateFrom"
                               t-on-change="onDateFromChange"/>
                        <span class="text-muted">–</span>
                        <input type="date" class="form-control form-control-sm w-auto"
                               t-att-value="state.dateTo"
                               t-on-change="onDateToChange"/>
                    </div>
                    <div class="form-check">
                        <input id="o_mnp_uncovered" type="checkbox"
                               class="form-check-input"
                               t-att-checked="state.uncoveredOnly"
                               t-on-change="onUncoveredChange"/>
                        <label for="o_mnp_uncovered" class="form-check-label text-nowrap">
                            Sadece karşılanmamış
                        </label>
                    </div>
                    <div class="form-check">
                        <input id="o_mnp_late" type="checkbox"
                               class="form-check-input"
                               t-att-checked="state.lateOnly"
                               t-on-change="onLateChange"/>
                        <label for="o_mnp_late" class="form-check-label text-nowrap">
                            Gecikme riski
                        </label>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 text-nowrap">Sırala</label>
                        <select class="form-select form-select-sm w-auto"
                                t-on-change="onSortChange">
                            <option value="purchase_start"
                                    t-att-selected="state.sortBy === 'purchase_start'">
                                Satınalma başlangıcı
                            </option>
                            <option value="need_date"
                                    t-att-selected="state.sortBy === 'need_date'">
                                İhtiyaç tarihi
                            </option>
                        </select>
                    </div>
                    <div class="o_mnp_cols ms-auto">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                t-on-click.stop="toggleColsMenu">
                            <i class="fa fa-columns me-1"/>Sütunlar
                        </button>
                        <t t-if="state.colsOpen">
                            <div class="o_mnp_cols_menu">
                                <label class="o_mnp_cols_item">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="state.showSource"
                                           t-on-change="onSourceToggle"/>
                                    <span>Kaynak</span>
                                </label>
                                <label class="o_mnp_cols_item">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="state.showMip"
                                           t-on-change="onMipToggle"/>
                                    <span>MİP No</span>
                                </label>
                                <label class="o_mnp_cols_item">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="state.showType"
                                           t-on-change="onTypeToggle"/>
                                    <span>Tür</span>
                                </label>
                                <label class="o_mnp_cols_item">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="state.showExc"
                                           t-on-change="onExcToggle"/>
                                    <span>İstisna</span>
                                </label>
                                <label class="o_mnp_cols_item">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-checked="state.showRoute"
                                           t-on-change="onRouteToggle"/>
                                    <span>Rota</span>
                                </label>
                            </div>
                            <div class="o_mnp_cols_backdrop"
                                 t-on-click="toggleColsMenu"/>
                        </t>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="state.loading"
                            t-on-click="() => this.loadGroups(true)">
                        <i class="fa fa-refresh me-1"
                           t-att-class="{'fa-spin': state.loading}"/>Yenile
                    </button>
                </div>

                <div t-if="missingConfigGroups.length"
                     class="alert alert-warning d-flex align-items-center gap-2 mt-2 mb-0 py-2">
                    <i class="fa fa-exclamation-triangle"/>
                    <span>
                        <t t-esc="missingConfigGroups.length"/> ürün grubu için
                        satınalma süresi tanımlanmamış — ürün kartından veya
                        Satınalma ayarlarından tanımlayın; tarihler 0 gün ile
                        hesaplandı.
                    </span>
                </div>
            </div>

            <!-- Liste -->
            <div class="o_mnp_grid flex-grow-1 overflow-auto position-relative">
                <table class="o_mnp_table">
                    <colgroup>
                        <col class="o_mnp_col_sel"/>
                        <col class="o_mnp_col_exp"/>
                        <col class="o_mnp_col_product"/>
                        <col class="o_mnp_col_resp"/>
                        <col class="o_mnp_col_resp"/>
                        <col t-if="state.showType" class="o_mnp_col_type"/>
                        <col t-if="state.showSource" class="o_mnp_col_src"/>
                        <col t-if="state.showMip" class="o_mnp_col_mip"/>
                        <col class="o_mnp_col_date"/>
                        <col class="o_mnp_col_date"/>
                        <col t-if="state.showExc" class="o_mnp_col_exc"/>
                        <col class="o_mnp_col_loc"/>
                        <col t-if="state.showRoute" class="o_mnp_col_route"/>
                        <col class="o_mnp_col_qty"/>
                        <col class="o_mnp_col_qty"/>
                        <col class="o_mnp_col_qty"/>
                        <col class="o_mnp_col_qty"/>
                        <col class="o_mnp_col_qty"/>
                        <col class="o_mnp_col_qty"/>
                        <col class="o_mnp_col_uom"/>
                        <col class="o_mnp_col_days"/>
                        <col class="o_mnp_col_date"/>
                        <col class="o_mnp_col_date"/>
                        <col class="o_mnp_col_status"/>
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="o_mnp_col_sel"></th>
                            <th class="o_mnp_col_exp"></th>
                            <th class="o_mnp_col_product">Ürün</th>
                            <th>MİP Sorumlusu</th>
                            <th>SA Sorumlusu</th>
                            <th t-if="state.showType">Tür</th>
                            <th t-if="state.showSource">Kaynak</th>
                            <th t-if="state.showMip">MİP No</th>
                            <th>İhtiyaç Tarihi</th>
                            <th>Öneri Termin</th>
                            <th t-if="state.showExc">İstisna</th>
                            <th>Konum</th>
                            <th t-if="state.showRoute">Rota</th>
                            <th class="o_mnp_num">Stok</th>
                            <th class="o_mnp_num">Öngörülen</th>
                            <th class="o_mnp_num">İhtiyaç Miktarı</th>
                            <th class="o_mnp_num">Karşılanan</th>
                            <th class="o_mnp_num">Açık</th>
                            <th class="o_mnp_num">Planla</th>
                            <th>Birim</th>
                            <th class="o_mnp_num">Gün</th>
                            <th>Başlangıç</th>
                            <th>Son Onay</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="visibleGroups" t-as="group" t-key="group.product_id">
                            <!-- ürün grubu başlığı -->
                            <tr t-att-class="groupClass(group)">
                                <td>
                                    <input type="checkbox" class="form-check-input"
                                           title="Gruptaki tüm seçilebilir satırları seç/kaldır"
                                           t-att-checked="groupChecked(group)"
                                           t-att-disabled="!state.canCreate"
                                           t-on-change="(ev) => this.toggleSelectAll(group, ev)"
                                           t-on-click.stop="() => {}"/>
                                </td>
                                <td>
                                    <button type="button" class="o_mnp_expander"
                                            t-on-click="() => this.toggleGroup(group)">
                                        <i t-att-class="'fa ' + (isExpanded(group) ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                    </button>
                                </td>
                                <td class="o_mnp_product">
                                    <strong t-esc="group.name"/>
                                    <span class="text-muted ms-2 o_mnp_rowcount"
                                          t-esc="`· ${group.need_count} satır`"/>
                                </td>
                                <td class="o_mnp_summary text-muted"
                                    t-esc="group.mip_resp"/>
                                <td class="o_mnp_summary text-muted"
                                    t-esc="group.sa_resp"/>
                                <td t-if="state.showType"/>
                                <td t-if="state.showSource"/>
                                <td t-if="state.showMip"/>
                                <td class="o_mnp_summary"
                                    t-esc="fmtDate(group.earliest_need)"/>
                                <td class="o_mnp_summary text-warning">
                                    <strong t-esc="fmtDate(group.earliest_termin)"/>
                                </td>
                                <td t-if="state.showExc"
                                    class="o_mnp_summary text-muted">
                                    <t t-if="group.exception_count">Yeniden Termin
                                        (<t t-esc="group.exception_count"/>)</t>
                                </td>
                                <td class="o_mnp_summary text-muted"
                                    t-esc="group.location"/>
                                <td t-if="state.showRoute"
                                    class="o_mnp_summary text-center"
                                    t-esc="group.route"/>
                                <td class="o_mnp_num o_mnp_summary">
                                    <strong t-esc="fmtQty(group.onhand)"/>
                                </td>
                                <td t-att-class="'o_mnp_num o_mnp_summary' + (group.end_forecast &lt; 0 ? ' o_mnp_neg' : '')">
                                    <strong t-esc="fmtQty(group.end_forecast)"/>
                                </td>
                                <td class="o_mnp_num o_mnp_summary">
                                    <strong t-esc="fmtQty(group.total_need)"/>
                                </td>
                                <td class="o_mnp_num o_mnp_summary">
                                    <strong t-esc="fmtQty(group.total_need - group.total_uncovered)"/>
                                </td>
                                <td t-att-class="'o_mnp_num o_mnp_summary' + (group.total_uncovered > 0 ? ' o_mnp_neg' : '')">
                                    <strong t-esc="fmtQty(group.total_uncovered)"/>
                                </td>
                                <td class="o_mnp_num o_mnp_summary">
                                    <t t-if="groupSelectedQty(group)">
                                        <strong class="text-primary"
                                                t-esc="fmtQty(groupSelectedQty(group))"/>
                                    </t>
                                </td>
                                <td class="o_mnp_summary text-muted"
                                    t-esc="group.uom"/>
                                <td t-att-class="'o_mnp_num o_mnp_summary' + (daysUntil(group.earliest_start) &lt; 0 ? ' o_mnp_neg' : '')">
                                    <strong t-esc="daysUntil(group.earliest_start)"/>
                                </td>
                                <td class="o_mnp_summary">
                                    <strong t-esc="fmtDate(group.earliest_start)"/>
                                </td>
                                <td class="o_mnp_summary"
                                    t-esc="fmtDate(group.earliest_approve)"/>
                                <td>
                                    <button t-if="group.suggestion_count"
                                            type="button"
                                            class="btn btn-sm btn-outline-primary o_mnp_sug_btn"
                                            t-on-click.stop="() => this.openSuggestions(group)">
                                        <i class="fa fa-level-up me-1"/>Öneri
                                        (<t t-esc="group.suggestion_count"/>)
                                    </button>
                                </td>
                            </tr>
                            <!-- ihtiyaç detay satırları -->
                            <t t-if="isExpanded(group)">
                                <t t-foreach="groupLines(group)" t-as="line" t-key="line.key">
                                    <tr t-att-class="lineClass(line)">
                                        <td>
                                            <input type="checkbox" class="form-check-input"
                                                   t-if="isSelectable(line)"
                                                   t-att-checked="isLineSelected(line)"
                                                   t-att-disabled="!state.canCreate"
                                                   t-on-change="(ev) => this.toggleLine(line, group, ev)"
                                                   t-on-click.stop="() => {}"/>
                                        </td>
                                        <td></td>
                                        <td class="o_mnp_product">
                                            <span class="text-muted"
                                                  t-esc="group.name"/>
                                        </td>
                                        <td class="text-muted"
                                            t-esc="group.mip_resp"/>
                                        <td class="text-muted"
                                            t-esc="group.sa_resp"/>
                                        <td t-if="state.showType"
                                            class="text-center">
                                            <span class="o_mnp_type"
                                                  t-esc="line.source_type"/>
                                        </td>
                                        <td t-if="state.showSource"
                                            class="o_mnp_source text-muted"
                                            t-esc="line.source"/>
                                        <td t-if="state.showMip"
                                            class="o_mnp_mip text-muted">
                                            <a t-if="line.doc_model" href="#"
                                               class="o_mnp_cov_link"
                                               t-on-click.prevent="() => this.openLineDoc(line)"
                                               t-esc="line.mip_name"/>
                                            <t t-else="" t-esc="line.mip_name"/>
                                        </td>
                                        <td t-esc="fmtDate(line.need_date)"/>
                                        <td t-att-class="line.suggested_termin ? 'text-warning' : ''"
                                            t-esc="fmtDate(line.suggested_termin)"/>
                                        <td t-if="state.showExc">
                                            <a t-if="line.exception" href="#"
                                               class="o_mnp_cov_link"
                                               t-on-click.prevent="() => this.openExceptions(line)"
                                            >Yeniden Terminlendi</a>
                                        </td>
                                        <td t-esc="line.location"/>
                                        <td t-if="state.showRoute"
                                            class="text-center"
                                            t-esc="line.route"/>
                                        <td class="o_mnp_num" t-esc="fmtQty(line.onhand)"/>
                                        <td t-att-class="'o_mnp_num' + (line.forecast &lt; 0 ? ' o_mnp_neg' : '')"
                                            t-esc="fmtQty(line.forecast)"/>
                                        <td class="o_mnp_num"
                                            t-esc="fmtQty(line.need_qty)"/>
                                        <td class="o_mnp_num">
                                            <a t-if="line.covered_qty > 0"
                                               href="#"
                                               class="o_mnp_cov_link"
                                               t-on-click.prevent="() => this.openCoverage(line)"
                                               t-esc="fmtQty(line.covered_qty)"/>
                                            <t t-else=""
                                               t-esc="fmtQty(line.covered_qty)"/>
                                        </td>
                                        <td t-att-class="'o_mnp_num' + (line.uncovered_qty > 0 ? ' o_mnp_neg' : '')"
                                            t-esc="fmtQty(line.uncovered_qty)"/>
                                        <td class="o_mnp_num">
                                            <input t-if="isSelectable(line)"
                                                   type="number" min="0" step="any"
                                                   class="form-control form-control-sm o_mnp_qty_input"
                                                   t-att-value="requestQtyOf(line)"
                                                   t-att-disabled="!isLineSelected(line)"
                                                   t-on-change="(ev) => this.onQtyChange(line, ev)"
                                                   t-on-click.stop="() => {}"/>
                                        </td>
                                        <td class="text-muted" t-esc="line.uom"/>
                                        <td t-att-class="'o_mnp_num' + (daysUntil(line.purchase_start) &lt; 0 ? ' o_mnp_neg' : '')"
                                            t-esc="daysUntil(line.purchase_start)"/>
                                        <td t-esc="fmtDate(line.purchase_start)"/>
                                        <td t-esc="fmtDate(line.approve_by)"/>
                                        <td class="o_mnp_status">
                                            <span t-if="line.uncovered_qty &lt;= 0"
                                                  class="badge text-bg-success">Karşılandı</span>
                                            <span t-elif="daysUntil(line.approve_by) &lt; 0"
                                                  class="badge text-bg-danger">Geciken</span>
                                            <span t-elif="daysUntil(line.purchase_start) > 0"
                                                  class="badge text-bg-secondary">Bekleyen</span>
                                            <span t-else=""
                                                  class="badge text-bg-warning">Açık</span>
                                        </td>
                                    </tr>
                                </t>
                                <tr t-if="state.lines[group.product_id] === undefined"
                                    class="o_mnp_line">
                                    <td t-att-colspan="17 + (state.showType ? 1 : 0) + (state.showSource ? 1 : 0) + (state.showMip ? 1 : 0) + (state.showExc ? 1 : 0) + (state.showRoute ? 1 : 0)"
                                        class="text-muted text-center">
                                        Yükleniyor…
                                    </td>
                                </tr>
                                <tr t-elif="!groupLines(group).length" class="o_mnp_line">
                                    <td t-att-colspan="17 + (state.showType ? 1 : 0) + (state.showSource ? 1 : 0) + (state.showMip ? 1 : 0) + (state.showExc ? 1 : 0) + (state.showRoute ? 1 : 0)"
                                        class="text-muted text-center">
                                        Bu kapsamda ihtiyaç satırı yok.
                                    </td>
                                </tr>
                                <!-- öne çekme önerileri artık "Öneri" butonu
                                     ile açılan diyalogda gösteriliyor (§7.3) -->
                            </t>
                        </t>
                    </tbody>
                </table>

                <div t-if="state.total &gt; state.pageSize"
                     class="o_mnp_pager d-flex align-items-center justify-content-end gap-2 px-3 py-2 border-top">
                    <span class="text-muted small">
                        Toplam <t t-esc="state.total"/> ürün — Sayfa
                        <t t-esc="state.page + 1"/> / <t t-esc="totalPages"/>
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="state.page &lt;= 0"
                            t-on-click="prevPage">‹ Önceki</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            t-att-disabled="(state.page + 1) * state.pageSize >= state.total"
                            t-on-click="nextPage">Sonraki ›</button>
                </div>
                <div t-if="state.loading"
                     class="o_mnp_overlay d-flex align-items-center justify-content-center">
                    <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
                </div>
                <div t-if="!state.loading &amp;&amp; !visibleGroups.length"
                     class="o_mnp_empty text-muted text-center py-5">
                    Mevcut filtrelere uygun malzeme ihtiyacı bulunamadı.
                </div>
            </div>
        </div>
    </t>

    <t t-name="mrp_purchase_need_plan.SuggestionsDialog">
        <Dialog title="'Öneriler'" size="lg">
            <div class="o_mnp_sug_list">
                <div t-foreach="props.suggestions" t-as="sug" t-key="sug_index"
                     class="o_mnp_sug_card border rounded p-3 mb-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="fs-6">
                            <a href="#" class="o_mnp_order_link fw-bold"
                               t-on-click.prevent="() => this.onOrderClick(sug)">
                                <t t-esc="sug.order"/>
                            </a>
                            <span class="text-muted" t-esc="` · ${sug.partner}`"/>
                        </div>
                        <div class="text-end">
                            <span t-if="sug.kind === 'pull'"
                                  class="badge text-bg-primary">İşlemi Öne Al</span>
                            <span t-elif="sug.kind === 'cancel'"
                                  class="badge text-bg-danger">İşlemi İptal Et</span>
                            <span t-else=""
                                  class="badge text-bg-warning">Miktarı Azalt</span>
                            <div t-if="sug.kind === 'pull'"
                                 class="text-muted small mt-1"
                                 t-esc="`${sug.days} gün öne`"/>
                        </div>
                    </div>
                    <div class="d-flex gap-4 mt-2 flex-wrap">
                        <div>
                            <div class="o_mnp_sug_label">Sipariş Miktarı</div>
                            <strong t-esc="`${props.fmtQty(sug.order_qty)} adet`"/>
                        </div>
                        <div>
                            <div class="o_mnp_sug_label">Beklenen Teslim</div>
                            <strong t-esc="props.fmtDate(sug.current_date)"/>
                        </div>
                        <div t-if="sug.kind === 'pull'">
                            <div class="o_mnp_sug_label">Önerilen Teslim</div>
                            <strong class="text-primary"
                                    t-esc="props.fmtDate(sug.suggested_date)"/>
                        </div>
                        <div t-if="sug.kind === 'reduce'">
                            <div class="o_mnp_sug_label">Kullanılmayan Miktar</div>
                            <strong class="text-warning"
                                    t-esc="`${props.fmtQty(sug.surplus_qty)} adet`"/>
                        </div>
                    </div>
                    <table t-if="sug.kind === 'pull'"
                           class="table table-sm o_mnp_sug_table mt-3 mb-0">
                        <thead>
                            <tr>
                                <th>Karşılanan İhtiyaç Tarihi</th>
                                <th class="text-end">Miktar</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="sug.covers" t-as="cov"
                                t-key="cov.need_date">
                                <td t-esc="props.fmtDate(cov.need_date)"/>
                                <td class="text-end"
                                    t-esc="`${props.fmtQty(cov.qty)} adet`"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="alert alert-info d-flex align-items-center gap-2 mb-0 py-2 small">
                <i class="fa fa-info-circle"/>
                <span>
                    Öneriler bilgilendirme amaçlıdır; ilgili satınalma
                    belgesi üzerinden işlem yapılmalıdır.
                </span>
            </div>
        </Dialog>
    </t>

    <t t-name="mrp_purchase_need_plan.CoverageDialog">
        <Dialog title="'Karşılanma Detayı'" size="md">
            <table t-if="props.coverage.length" class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Tür</th>
                        <th>Belge</th>
                        <th>Tedarikçi</th>
                        <th>Beklenen Geliş</th>
                        <th class="text-end">Miktar</th>
                        <th>Birim</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="props.coverage" t-as="cov" t-key="cov_index">
                        <td class="text-muted" t-esc="cov.kind_label"/>
                        <td>
                            <a t-if="cov.order_id" href="#"
                               class="o_mnp_order_link"
                               t-on-click.prevent="() => this.onOrderClick(cov)"
                               t-esc="cov.name"/>
                            <t t-else="" t-esc="cov.name"/>
                        </td>
                        <td class="text-muted" t-esc="cov.partner"/>
                        <td t-esc="props.fmtDate(cov.date)"/>
                        <td class="text-end" t-esc="props.fmtQty(cov.qty)"/>
                        <td class="text-muted" t-esc="cov.uom"/>
                    </tr>
                </tbody>
            </table>
            <div t-else="" class="text-muted">
                Bu ihtiyacın karşılanmış kısmı yok.
            </div>
        </Dialog>
    </t>

    <t t-name="mrp_purchase_need_plan.RescheduleDialog">
        <Dialog title="'Termin Geçmişi'" size="md">
            <table t-if="props.logs.length" class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Kayıt No</th>
                        <th>Değiştiren</th>
                        <th>Değişiklik Tarihi</th>
                        <th>Planlanan Tarih</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="props.logs" t-as="log" t-key="log_index">
                        <td t-esc="log.doc"/>
                        <td class="text-muted" t-esc="log.user"/>
                        <td t-esc="props.fmtDate(log.date)"/>
                        <td t-esc="props.fmtDate(log.planned)"/>
                    </tr>
                </tbody>
            </table>
            <div t-else="" class="text-muted">
                Bu ihtiyaç için termin değişikliği yok.
            </div>
        </Dialog>
    </t>
</templates>
