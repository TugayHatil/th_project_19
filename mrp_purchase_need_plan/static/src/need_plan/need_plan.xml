<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_purchase_need_plan.NeedPlan">
        <div class="o_mnp d-flex flex-column h-100 overflow-hidden">

            <!-- Araç çubuğu -->
            <div class="o_mnp_toolbar border-bottom px-3 py-2">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h4 class="mb-0">Malzeme İhtiyaç Planlama</h4>
                    <button type="button" class="btn btn-sm btn-primary"
                            t-att-disabled="!state.canCreate or !selectedCount or state.creating"
                            t-on-click="onCreateRequest">
                        <i class="fa fa-shopping-cart me-1"/>Seçilen İhtiyaçlar İçin Satınalma Talebi Oluştur
                        <t t-if="selectedCount"> (<t t-esc="selectedCount"/>)</t>
                    </button>
                </div>
                <div class="d-flex align-items-center gap-3 mt-2 flex-wrap">
                    <input type="text" class="form-control form-control-sm o_mnp_search"
                           placeholder="Ürün adı veya kodu ara…"
                           t-on-input="onSearchInput"/>
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 text-nowrap">Depo</label>
                        <select class="form-select form-select-sm w-auto"
                                t-on-change="onWarehouseChange">
                            <option value="">Tümü</option>
                            <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                                <option t-att-value="wh.id"
                                        t-att-selected="wh.id === state.warehouseId"
                                        t-esc="`${wh.name} (${wh.code})`"/>
                            </t>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 text-nowrap">İhtiyaç tarihi</label>
                        <input type="date" class="form-control form-control-sm w-auto"
                               t-att-value="state.dateFrom"
                               t-on-change="onDateFromChange"/>
                        <span class="text-muted">–</span>
                        <input type="date" class="form-control form-control-sm w-auto"
                               t-att-value="state.dateTo"
                               t-on-change="onDateToChange"/>
                    </div>
                    <div class="form-check">
                        <input id="o_mnp_uncovered" type="checkbox"
                               class="form-check-input"
                               t-att-checked="state.uncoveredOnly"
                               t-on-change="onUncoveredChange"/>
                        <label for="o_mnp_uncovered" class="form-check-label text-nowrap">
                            Sadece karşılanmamış
                        </label>
                    </div>
                    <div class="form-check">
                        <input id="o_mnp_late" type="checkbox"
                               class="form-check-input"
                               t-att-checked="state.lateOnly"
                               t-on-change="onLateChange"/>
                        <label for="o_mnp_late" class="form-check-label text-nowrap">
                            Gecikme riski
                        </label>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 text-nowrap">Sırala</label>
                        <select class="form-select form-select-sm w-auto"
                                t-on-change="onSortChange">
                            <option value="purchase_start"
                                    t-att-selected="state.sortBy === 'purchase_start'">
                                Satınalma başlangıcı
                            </option>
                            <option value="need_date"
                                    t-att-selected="state.sortBy === 'need_date'">
                                İhtiyaç tarihi
                            </option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto"
                            t-on-click="loadGroups">
                        <i class="fa fa-refresh me-1"/>Yenile
                    </button>
                </div>

                <div t-if="missingConfigGroups.length"
                     class="alert alert-warning d-flex align-items-center gap-2 mt-2 mb-0 py-2">
                    <i class="fa fa-exclamation-triangle"/>
                    <span>
                        <t t-esc="missingConfigGroups.length"/> ürün grubu için
                        satınalma süresi tanımlanmamış — ürün kartından veya
                        Satınalma ayarlarından tanımlayın; tarihler 0 gün ile
                        hesaplandı.
                    </span>
                </div>
            </div>

            <!-- Liste -->
            <div class="o_mnp_grid flex-grow-1 overflow-auto position-relative">
                <table class="o_mnp_table">
                    <colgroup>
                        <col class="o_mnp_col_sel"/>
                        <col class="o_mnp_col_exp"/>
                        <col class="o_mnp_col_product"/>
                        <col class="o_mnp_col_date"/>
                        <col class="o_mnp_col_loc"/>
                        <col class="o_mnp_col_qty"/>
                        <col class="o_mnp_col_qty"/>
                        <col class="o_mnp_col_qty"/>
                        <col class="o_mnp_col_date"/>
                        <col class="o_mnp_col_date"/>
                        <col class="o_mnp_col_status"/>
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="o_mnp_col_sel"></th>
                            <th class="o_mnp_col_exp"></th>
                            <th class="o_mnp_col_product">Ürün</th>
                            <th>İhtiyaç Tarihi</th>
                            <th>Konum</th>
                            <th class="o_mnp_num">Mevcut Stok</th>
                            <th class="o_mnp_num">Öngörülen Miktar</th>
                            <th class="o_mnp_num">İhtiyaç Miktarı</th>
                            <th>Satınalma Başlangıcı</th>
                            <th>Son Onay Tarihi</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="visibleGroups" t-as="group" t-key="group.product_id">
                            <!-- ürün grubu başlığı -->
                            <tr t-att-class="groupClass(group)">
                                <td>
                                    <input type="checkbox" class="form-check-input"
                                           title="Gruptaki tüm seçilebilir satırları seç/kaldır"
                                           t-att-checked="groupChecked(group)"
                                           t-att-disabled="!state.canCreate"
                                           t-on-change="(ev) => this.toggleSelectAll(group, ev)"
                                           t-on-click.stop="() => {}"/>
                                </td>
                                <td>
                                    <button type="button" class="o_mnp_expander"
                                            t-on-click="() => this.toggleGroup(group)">
                                        <i t-att-class="'fa ' + (isExpanded(group) ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                    </button>
                                </td>
                                <td class="o_mnp_product">
                                    <span class="o_mnp_code" t-if="group.code"
                                          t-esc="`[${group.code}] `"/>
                                    <strong t-esc="group.name"/>
                                    <span class="text-muted" t-esc="` (${group.uom})`"/>
                                    <span class="text-muted ms-2 o_mnp_rowcount"
                                          t-esc="`· ${group.need_count} satır`"/>
                                </td>
                                <td/>
                                <td/>
                                <td class="o_mnp_num o_mnp_summary">
                                    <strong t-esc="fmtQty(group.onhand)"/>
                                </td>
                                <td/>
                                <td class="o_mnp_num o_mnp_summary">
                                    <strong t-esc="fmtQty(group.total_uncovered)"/>
                                    <span class="text-muted"
                                          t-esc="` / ${fmtQty(group.total_need)}`"/>
                                </td>
                                <td class="o_mnp_summary">
                                    <strong t-esc="fmtDate(group.earliest_start)"/>
                                </td>
                                <td/>
                                <td>
                                    <span t-if="group.suggestion_count"
                                          class="badge text-bg-primary">
                                        <i class="fa fa-level-up me-1"/>Öneri:
                                        <t t-esc="group.suggestion_count"/>
                                    </span>
                                </td>
                            </tr>
                            <!-- ihtiyaç detay satırları -->
                            <t t-if="isExpanded(group)">
                                <t t-foreach="groupLines(group)" t-as="line" t-key="line.move_id">
                                    <tr t-att-class="lineClass(line)">
                                        <td>
                                            <input type="checkbox" class="form-check-input"
                                                   t-if="isSelectable(line)"
                                                   t-att-checked="isLineSelected(line)"
                                                   t-att-disabled="!state.canCreate"
                                                   t-on-change="(ev) => this.toggleLine(line, group, ev)"
                                                   t-on-click.stop="() => {}"/>
                                        </td>
                                        <td></td>
                                        <td class="o_mnp_source text-muted" t-esc="line.source"/>
                                        <td t-esc="fmtDate(line.need_date)"/>
                                        <td t-esc="line.location"/>
                                        <td class="o_mnp_num" t-esc="fmtQty(line.onhand)"/>
                                        <td t-att-class="'o_mnp_num' + (line.forecast &lt; 0 ? ' o_mnp_neg' : '')"
                                            t-esc="fmtQty(line.forecast)"/>
                                        <td class="o_mnp_num">
                                            <t t-esc="fmtQty(line.need_qty)"/>
                                            <t t-if="line.uncovered_qty > 0 and line.uncovered_qty &lt; line.need_qty">
                                                <span class="text-muted"
                                                      t-esc="` (${fmtQty(line.uncovered_qty)} açık)`"/>
                                            </t>
                                        </td>
                                        <td t-esc="fmtDate(line.purchase_start)"/>
                                        <td t-esc="fmtDate(line.approve_by)"/>
                                        <td>
                                            <span t-if="line.pull_covered > 0"
                                                  class="badge text-bg-primary me-1"
                                                  t-esc="`+${fmtQty(line.pull_covered)} öneri`"/>
                                            <span t-if="line.already_requested"
                                                  class="badge text-bg-info">Talep edildi</span>
                                            <span t-elif="line.uncovered_qty &lt;= 0"
                                                  class="badge text-bg-success">Karşılandı</span>
                                            <span t-elif="line.is_late"
                                                  class="badge text-bg-danger">Gecikmiş</span>
                                            <span t-else=""
                                                  class="badge text-bg-warning">Açık</span>
                                        </td>
                                    </tr>
                                </t>
                                <tr t-if="!groupLines(group).length" class="o_mnp_line">
                                    <td colspan="11" class="text-muted text-center">
                                        Yükleniyor…
                                    </td>
                                </tr>
                                <!-- öne çekme önerileri -->
                                <tr t-foreach="groupSuggestions(group)" t-as="sug"
                                    t-key="sug.move_id" class="o_mnp_suggestion">
                                    <td colspan="11">
                                        <i class="fa fa-level-up me-2"/>
                                        <a href="#" class="o_mnp_order_link"
                                           t-on-click.prevent="() => this.openOrder(sug)">
                                            <strong t-esc="sug.order"/>
                                        </a>
                                        <span class="text-muted" t-esc="` (${sug.partner})`"/>
                                        <span class="ms-2" t-esc="`${fmtQty(sug.order_qty)} adet`"/>
                                        <span class="mx-1">·</span>
                                        beklenen <strong t-esc="fmtDate(sug.current_date)"/>
                                        <i class="fa fa-long-arrow-right mx-1"/>
                                        önerilen <strong class="text-primary" t-esc="fmtDate(sug.suggested_date)"/>
                                        <span class="badge text-bg-primary ms-2"
                                              t-esc="`${sug.days} gün öne`"/>
                                        <span class="ms-2">karşılıyor:
                                            <strong t-esc="coversText(sug)"/></span>
                                        <div class="o_mnp_suggestion_note text-muted">
                                            Öneri bilgilendirme amaçlıdır; teslim tarihi tedarikçi teyidi sonrası ilgili satınalma siparişi üzerinden güncellenmelidir.
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div t-if="state.loading"
                     class="o_mnp_overlay d-flex align-items-center justify-content-center">
                    <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
                </div>
                <div t-if="!state.loading &amp;&amp; !visibleGroups.length"
                     class="o_mnp_empty text-muted text-center py-5">
                    Mevcut filtrelere uygun malzeme ihtiyacı bulunamadı.
                </div>
            </div>
        </div>
    </t>
</templates>
