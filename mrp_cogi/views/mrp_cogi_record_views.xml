<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_cogi_record_view_list" model="ir.ui.view">
        <field name="name">mrp.cogi.record.list</field>
        <field name="model">mrp.cogi.record</field>
        <field name="arch" type="xml">
            <list string="COGI" create="0"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'closed'"
                  decoration-danger="state == 'open'">
                <field name="name"/>
                <field name="create_date" string="Oluşturulma Tarihi"/>
                <field name="production_id"/>
                <field name="finished_product_id" string="Üretilecek Ürün"/>
                <field name="product_id" string="Bileşen"/>
                <field name="planned_qty"/>
                <field name="consumed_qty"/>
                <field name="remaining_qty" string="Eksik Miktar"/>
                <field name="correction_progress" widget="progressbar"
                       string="Düzeltme" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state in ('open', 'reprocessing')"
                       decoration-info="state == 'closed'"/>
                <field name="error_message" optional="hide"/>
                <field name="operator_id" optional="hide"/>
                <field name="responsible_id" optional="show"/>
                <field name="last_processed_at" optional="hide"/>
                <field name="close_reason" optional="hide"/>
                <field name="last_result_note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mrp_cogi_record_view_form" model="ir.ui.view">
        <field name="name">mrp.cogi.record.form</field>
        <field name="model">mrp.cogi.record</field>
        <field name="arch" type="xml">
            <form string="COGI" create="0" duplicate="0">
                <header>
                    <button name="action_reprocess" type="object" string="Yeniden İşle"
                            class="btn-primary" invisible="state != 'open'"
                            confirm="Eksik miktar için yeni stok hareketi oluşturulacak. Devam edilsin mi?"/>
                    <button name="%(mrp_cogi_close_wizard_action)d" type="action"
                            string="Düzeltmeden Kapat" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,reprocessing,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_correction_moves" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="correction_move_count == 0">
                            <field name="correction_move_count" widget="statinfo"
                                   string="Stok Hareketleri"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Öne çıkan blok: üretim emri, bileşen, eksik miktar -->
                    <div class="row g-3 border rounded bg-light p-3 mb-3" name="hero">
                        <div class="col-12 col-md">
                            <div class="text-muted small text-uppercase">Üretim Emri</div>
                            <field name="production_id" readonly="1"
                                   class="fs-4 fw-bold" invisible="not production_id"/>
                            <field name="production_name" readonly="1"
                                   class="fs-4 fw-bold" invisible="production_id"/>
                        </div>
                        <div class="col-12 col-md">
                            <div class="text-muted small text-uppercase">Bileşen</div>
                            <field name="product_id" readonly="1"
                                   class="fs-4 fw-bold" invisible="not product_id"/>
                            <field name="component_name" readonly="1"
                                   class="fs-4 fw-bold" invisible="product_id"/>
                        </div>
                        <div class="col-12 col-md">
                            <div class="text-muted small text-uppercase">Eksik Miktar</div>
                            <span class="fs-3 fw-bold text-danger">
                                <field name="remaining_qty" readonly="1" class="oe_inline"/>
                            </span>
                            <field name="product_uom_id" readonly="1"
                                   class="oe_inline fs-4 text-danger ms-1"
                                   options="{'no_open': True}"/>
                        </div>
                    </div>

                    <!-- Durum bloğu: açıkta uyarı, başarılıda onay, kapalıda gri bant -->
                    <div class="alert alert-warning d-flex align-items-center" role="alert"
                         invisible="state not in ('open', 'reprocessing')">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <strong>Malzeme yetersizliği</strong>
                        <span class="ms-2 text-muted" invisible="not error_message">
                            <field name="error_message" nolabel="1" readonly="1"
                                   class="oe_inline"/>
                        </span>
                    </div>
                    <div class="alert alert-success" role="alert" invisible="state != 'done'">
                        <div>
                            <i class="fa fa-check-circle me-1"/>
                            <strong>Düzeltme tamamlandı</strong>
                        </div>
                        <div class="small text-muted" invisible="not last_result_note">
                            <field name="last_result_note" nolabel="1" readonly="1"
                                   class="oe_inline"/>
                        </div>
                    </div>
                    <div class="alert alert-secondary" role="alert" invisible="state != 'closed'">
                        <i class="fa fa-ban me-1"/>
                        <strong>Kayıt düzeltme yapılmadan kapatıldı:</strong>
                        <field name="close_reason" nolabel="1" readonly="1"
                               class="oe_inline ms-1"/>
                    </div>

                    <!-- Miktar özeti -->
                    <h6 class="text-muted mt-2">MİKTAR ÖZETİ</h6>
                    <div class="row g-3 mb-3" name="kpi_strip">
                        <div class="col">
                            <div class="fs-4"><field name="planned_qty" readonly="1"
                                                     class="oe_inline"/></div>
                            <div class="text-muted small">Planlanan</div>
                        </div>
                        <div class="col">
                            <div class="fs-4"><field name="consumed_qty" readonly="1"
                                                     class="oe_inline"/></div>
                            <div class="text-muted small">Tüketilen</div>
                        </div>
                        <div class="col">
                            <div class="fs-4 text-danger">
                                <field name="initial_missing_qty" readonly="1" class="oe_inline"/>
                            </div>
                            <div class="text-muted small">İlk Eksik</div>
                        </div>
                        <div class="col">
                            <div class="fs-4 text-success">
                                <field name="corrected_qty" readonly="1" class="oe_inline"/>
                            </div>
                            <div class="text-muted small">Düzeltilen</div>
                        </div>
                        <div class="col">
                            <div class="fs-4 fw-bold text-danger">
                                <field name="remaining_qty" readonly="1" class="oe_inline"/>
                            </div>
                            <div class="text-muted small">Kalan Eksik</div>
                        </div>
                    </div>

                    <!-- Üretim / işlem bilgileri: etiket üstte, değer altta -->
                    <div class="row" name="info_cols">
                        <div class="col-12 col-md-6">
                            <h6 class="text-muted">ÜRETİM VE KONUM</h6>
                            <div class="mb-2">
                                <div class="text-muted small">Üretilecek Ürün</div>
                                <field name="finished_product_id" readonly="1" class="fw-bold"/>
                            </div>
                            <div class="mb-2">
                                <div class="text-muted small">Kaynak Stok Hareketi</div>
                                <field name="source_move_id" readonly="1"/>
                            </div>
                            <div class="mb-2">
                                <div class="text-muted small">Stok Konumu</div>
                                <field name="location_id" readonly="1"/>
                                <span class="oe_inline">→</span>
                                <field name="location_dest_id" readonly="1" class="oe_inline"/>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <h6 class="text-muted">İŞLEM BİLGİLERİ</h6>
                            <div class="mb-2">
                                <div class="text-muted small">COGI Sorumlusu</div>
                                <field name="responsible_id" class="fw-bold"/>
                            </div>
                            <div class="mb-2">
                                <div class="text-muted small">İşlemi Yapan</div>
                                <field name="operator_id" readonly="1"/>
                            </div>
                            <div class="mb-2">
                                <div class="text-muted small">Oluşturulma Tarihi</div>
                                <field name="create_date" readonly="1"/>
                            </div>
                            <div class="mb-2">
                                <div class="text-muted small">Deneme Sayısı</div>
                                <field name="attempt_count" readonly="1" class="fw-bold"/>
                            </div>
                            <div class="mb-2">
                                <div class="text-muted small">Son İşlem</div>
                                <field name="last_processed_at" readonly="1"/>
                                <span class="oe_inline" invisible="not last_processed_by">·</span>
                                <field name="last_processed_by" readonly="1" class="oe_inline"/>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="İşlem Geçmişi" name="history">
                            <group string="Oluşturulan Stok Hareketleri" name="grp_moves"
                                   invisible="not correction_move_ids">
                                <field name="correction_move_ids" nolabel="1" colspan="2">
                                    <list>
                                        <field name="reference"/>
                                        <field name="date"/>
                                        <field name="location_id"/>
                                        <field name="location_dest_id"/>
                                        <field name="quantity"/>
                                        <field name="product_uom"/>
                                        <field name="state" widget="badge"
                                               decoration-success="state == 'done'"
                                               decoration-warning="state in ('confirmed', 'waiting', 'partially_available', 'assigned')"
                                               decoration-danger="state == 'cancel'"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Son İşlem Sonucu" invisible="not last_result_note">
                                <field name="last_result_note" nolabel="1" colspan="2"/>
                            </group>
                            <group string="Düzeltme İlerlemesi">
                                <field name="correction_progress" widget="progressbar"
                                       nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Hata Detayları" name="errors"
                              invisible="not original_error_message and not error_message">
                            <group string="İlk Hata Mesajı" invisible="not original_error_message">
                                <field name="original_error_message" nolabel="1" colspan="2"/>
                            </group>
                            <group string="Son Hata Mesajı" invisible="not error_message">
                                <field name="error_message" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Kapatma Bilgileri" name="close"
                              invisible="state != 'closed'">
                            <group>
                                <group string="Kapatma">
                                    <field name="close_reason"/>
                                    <field name="close_note"/>
                                </group>
                                <group string="Kapatan">
                                    <field name="closed_by"/>
                                    <field name="closed_at"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="mrp_cogi_record_view_search" model="ir.ui.view">
        <field name="name">mrp.cogi.record.search</field>
        <field name="model">mrp.cogi.record</field>
        <field name="arch" type="xml">
            <search string="COGI">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id" string="Bileşen"/>
                <field name="finished_product_id"/>
                <field name="responsible_id"/>
                <filter name="open" string="Açık" domain="[('state', '=', 'open')]"/>
                <filter name="done" string="Başarılı" domain="[('state', '=', 'done')]"/>
                <filter name="closed" string="Düzeltmeden Kapatıldı"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="today" string="Bugün" date="create_date"/>
                <group>
                    <filter name="by_production" string="Üretim Emri" domain="[]"
                            context="{'group_by': 'production_id'}"/>
                    <filter name="by_product" string="Bileşen" domain="[]"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="by_state" string="Durum" domain="[]"
                            context="{'group_by': 'state'}"/>
                    <filter name="by_responsible" string="COGI Sorumlusu" domain="[]"
                            context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mrp_cogi_record_action" model="ir.actions.act_window">
        <field name="name">COGI</field>
        <field name="res_model">mrp.cogi.record</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Açık COGI kaydı bulunmuyor
            </p>
            <p>
                COGI kayıtları, üretim emirlerinde planlanan ile gerçekleşen
                bileşen tüketimi arasındaki farklar oluştuğunda otomatik
                oluşturulur.
            </p>
        </field>
    </record>

    <menuitem id="menu_mrp_cogi" name="COGI" action="mrp_cogi_record_action"
              parent="mrp.menu_mrp_reporting" sequence="15"/>

</odoo>
