<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_cogi" model="ir.ui.view">
        <field name="name">mrp.production.form.cogi</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_cogi_records" type="object"
                        class="oe_stat_button" icon="fa-exclamation-triangle"
                        invisible="cogi_count == 0">
                    <field name="cogi_count" widget="statinfo" string="COGI"/>
                </button>
            </xpath>
            <!-- Bileşen listesinde COGI düzeltme satırlarını mavi ile vurgula ve
                 kaynak satırın hemen altında sırala -->
            <xpath expr="//page[@name='components']/field[@name='move_raw_ids']/list"
                   position="attributes">
                <attribute name="decoration-info">cogi_record_id</attribute>
                <attribute name="default_order">cogi_sort_key, id</attribute>
            </xpath>
            <xpath expr="//page[@name='components']/field[@name='move_raw_ids']/list/field[@name='product_id']"
                   position="before">
                <field name="cogi_indent" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='components']/field[@name='move_raw_ids']/list/field[@name='quantity']"
                   position="after">
                <field name="cogi_record_id" string="COGI Düzeltmesi" readonly="1"/>
                <field name="cogi_source_move_id" string="COGI Kaynak Satırı"
                       readonly="1" optional="hide"/>
                <field name="cogi_source_names" string="COGI Kaydı" readonly="1"/>
                <field name="source_cogi_ids" column_invisible="True"/>
            </xpath>
            <xpath expr="//page[@name='components']/field[@name='move_raw_ids']/list/field[@name='lot_ids']"
                   position="after">
                <button name="action_view_source_cogi" type="object"
                        icon="fa-exclamation-triangle" class="text-warning"
                        title="COGI kaydı açık - yeniden işleme bekliyor"
                        invisible="cogi_state not in ('open', 'reprocessing')"/>
                <button name="action_view_source_cogi" type="object"
                        icon="fa-check-circle" class="text-success"
                        title="COGI başarıyla tamamlandı"
                        invisible="cogi_state != 'done'"/>
                <button name="action_view_source_cogi" type="object"
                        icon="fa-ban" class="text-muted"
                        title="COGI düzeltmeden kapatıldı"
                        invisible="cogi_state != 'closed'"/>
                <field name="cogi_state" column_invisible="True"/>
            </xpath>
        </field>
    </record>

</odoo>
