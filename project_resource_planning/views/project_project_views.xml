<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Resource Plan + Material Plan pages on the project form — injected
         only when this addon is installed; the core project form keeps
         working without them. -->
    <record id="project_project_form_inherit_resource_plan" model="ir.ui.view">
        <field name="name">project.project.form.inherit.resource.plan</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="resource_plan" string="Resource Plan">
                    <group>
                        <group string="Resource Roles">
                            <field name="resource_rate_template_ids" widget="many2many_tags"/>
                            <field name="resource_currency_id" readonly="1"/>
                            <field name="resource_cost_currency_id" invisible="1"/>
                            <field name="planned_resource_cost" readonly="1"/>
                            <button name="action_open_resource_roles" string="Manage Resource Roles"
                                    type="object" class="btn-secondary"/>
                        </group>
                    </group>
                    <group string="Resource Summary">
                        <field name="resource_plan_summary_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="role_id"/>
                                <field name="total_quantity"/>
                                <field name="total_planned_hours" widget="float_time"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="total_planned_cost" optional="show"/>
                            </list>
                        </field>
                    </group>
                    <group string="Task Resource Requirements">
                        <field name="resource_requirement_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="role_id"/>
                                <field name="level" widget="priority"/>
                                <field name="task_id"/>
                                <field name="quantity"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="planned_hours" widget="float_time"/>
                                <field name="hourly_rate"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="planned_cost"/>
                                <field name="assigned_quantity"/>
                                <field name="assigned_hours" widget="float_time"/>
                                <field name="assignment_status" widget="badge"
                                       decoration-success="assignment_status == 'assigned'"
                                       decoration-warning="assignment_status == 'partial'"
                                       decoration-danger="assignment_status == 'waiting'"/>
                                <field name="description" optional="hide"/>
                            </list>
                        </field>
                    </group>
                    <group string="Actual Resource Assignments">
                        <field name="resource_assignment_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="employee_id" optional="hide"/>
                                <field name="equipment_id" optional="hide"/>
                                <field name="task_id"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="planned_hours" widget="float_time" readonly="1"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page name="material_plan_settings" string="Material Plan">
                    <group string="Default Stock Locations">
                        <group>
                            <field name="material_source_location_id"/>
                            <field name="material_destination_location_id"/>
                        </group>
                        <group>
                            <button name="action_open_material_plan" string="Open Material Plan"
                                    type="object" class="btn-secondary"/>
                        </group>
                    </group>
                    <group string="Stock Transfers">
                        <group>
                            <field name="material_picking_count" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_open_material_transfers" string="Open Transfers"
                                    type="object" class="btn-secondary"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="project_task_form_inherit_resource_requirements" model="ir.ui.view">
        <field name="name">project.task.form.inherit.resource.requirements</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="resource_requirements" string="Resource Requirements">
                    <group>
                        <field name="resource_cost_currency_id" invisible="1"/>
                        <field name="planned_resource_cost" readonly="1"/>
                    </group>
                    <field name="resource_requirement_ids" nolabel="1"
                           context="{'default_task_id': id}">
                        <list editable="bottom">
                            <field name="role_id"/>
                            <field name="level" widget="priority"/>
                            <field name="quantity"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="planned_hours" widget="float_time"/>
                            <field name="hourly_rate" readonly="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="planned_cost" readonly="1"/>
                            <field name="assigned_quantity" readonly="1"/>
                            <field name="assigned_hours" widget="float_time" readonly="1"/>
                            <field name="assignment_status" widget="badge" readonly="1"
                                   decoration-success="assignment_status == 'assigned'"
                                   decoration-warning="assignment_status == 'partial'"
                                   decoration-danger="assignment_status == 'waiting'"/>
                            <button name="action_open_resource_planner" string="Plan Resources"
                                    type="object" class="btn-secondary"/>
                            <button name="action_open_resource_assignments" string="Assign Resources"
                                    type="object" class="btn-secondary"/>
                            <field name="description" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_task_resource_assignment_list" model="ir.ui.view">
        <field name="name">project.task.resource.assignment.list</field>
        <field name="model">project.task.resource.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="requirement_id" invisible="1"/>
                <field name="employee_id" optional="hide"/>
                <field name="equipment_id" optional="hide"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="planned_hours" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="project_task_resource_assignment_form" model="ir.ui.view">
        <field name="name">project.task.resource.assignment.form</field>
        <field name="model">project.task.resource.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="requirement_id" invisible="1"/>
                        <field name="resource_category" invisible="1"/>
                        <field name="requirement_role_id" invisible="1"/>
                        <field name="employee_id" invisible="resource_category != 'human'"
                               domain="[('resource_role_ids', 'in', [requirement_role_id])]"/>
                        <field name="equipment_id" invisible="resource_category != 'equipment'"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="planned_hours" widget="float_time" readonly="1"/>
                        <button name="action_open_task" string="Open Task" type="object"
                                class="btn-secondary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_employee_form_inherit_resource_roles" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.resource.roles</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Resource Planning">
                    <field name="resource_role_ids" widget="many2many_tags"
                           domain="[('category', '=', 'human')]"/>
                    <field name="priority" widget="priority"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="project_resource_planner_form" model="ir.ui.view">
        <field name="name">project.resource.planner.form</field>
        <field name="model">project.resource.planner</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_timeline" string="Open Assignment Timeline"
                            type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <group string="Requirement Window">
                        <field name="requirement_id"/>
                        <field name="resource_category"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="resource_name"/>
                            <field name="availability_status" widget="badge"
                                   decoration-success="availability_status == 'fully_available'"
                                   decoration-warning="availability_status == 'partially_available'"
                                   decoration-danger="availability_status == 'unavailable'"/>
                            <field name="available_hours" widget="float_time"/>
                            <field name="booked_hours" widget="float_time"/>
                            <field name="booking_summary"/>
                            <button name="action_open_resource_timeline" string="Timeline"
                                    type="object" class="btn-secondary"/>
                            <button name="action_assign_resource" string="Assign"
                                    type="object" class="btn-primary"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_task_resource_assignment_gantt_employee" model="ir.ui.view">
        <field name="name">project.task.resource.assignment.gantt.employee</field>
        <field name="model">project.task.resource.assignment</field>
        <field name="arch" type="xml">
            <gantt string="Team Planner" date_start="date_start" date_stop="date_end"
                   default_group_by="employee_id" color="task_id">
                <field name="employee_id"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="planned_hours"/>
            </gantt>
        </field>
    </record>

    <record id="project_task_resource_assignment_gantt_equipment" model="ir.ui.view">
        <field name="name">project.task.resource.assignment.gantt.equipment</field>
        <field name="model">project.task.resource.assignment</field>
        <field name="arch" type="xml">
            <gantt string="Team Planner" date_start="date_start" date_stop="date_end"
                   default_group_by="equipment_id" color="task_id">
                <field name="equipment_id"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="planned_hours"/>
            </gantt>
        </field>
    </record>
</odoo>
