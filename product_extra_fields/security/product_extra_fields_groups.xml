<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_product_extra_fields" model="ir.module.category">
        <field name="name">Ürün Kartı Ek Alanları</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_material_group_manager" model="res.groups">
        <field name="name">Mal Grupları Yöneticisi</field>
        <field name="category_id"
               ref="product_extra_fields.module_category_product_extra_fields"/>
    </record>

    <record id="group_product_sub_type_manager" model="res.groups">
        <field name="name">Ürün Alt Türü Yöneticisi</field>
        <field name="category_id"
               ref="product_extra_fields.module_category_product_extra_fields"/>
    </record>

    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('product_extra_fields.group_material_group_manager')),
            (4, ref('product_extra_fields.group_product_sub_type_manager')),
        ]"/>
    </record>

</odoo>
