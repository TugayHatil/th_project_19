<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mip_definition_view_list" model="ir.ui.view">
        <field name="name">mip.definition.list</field>
        <field name="model">mip.definition</field>
        <field name="arch" type="xml">
            <list string="MİP Sorumluları">
                <field name="name"/>
                <field name="responsible"/>
            </list>
        </field>
    </record>

    <record id="mip_definition_view_form" model="ir.ui.view">
        <field name="name">mip.definition.form</field>
        <field name="model">mip.definition</field>
        <field name="arch" type="xml">
            <form string="MİP Tanımı">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="responsible"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mip_definition_action" model="ir.actions.act_window">
        <field name="name">MİP Sorumluları</field>
        <field name="res_model">mip.definition</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
