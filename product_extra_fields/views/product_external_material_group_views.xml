<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_external_material_group_view_list" model="ir.ui.view">
        <field name="name">product.external.material.group.list</field>
        <field name="model">product.external.material.group</field>
        <field name="arch" type="xml">
            <list string="Harici Mal Grupları">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="product_external_material_group_view_form" model="ir.ui.view">
        <field name="name">product.external.material.group.form</field>
        <field name="model">product.external.material.group</field>
        <field name="arch" type="xml">
            <form string="Harici Mal Grubu">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_external_material_group_action" model="ir.actions.act_window">
        <field name="name">Harici Mal Grupları</field>
        <field name="res_model">product.external.material.group</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
