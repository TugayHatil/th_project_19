<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="production_supervisor_view_list" model="ir.ui.view">
        <field name="name">production.supervisor.list</field>
        <field name="model">production.supervisor</field>
        <field name="arch" type="xml">
            <list string="Üretim Sorumluları">
                <field name="name"/>
                <field name="responsible_id" widget="many2one_avatar_employee"/>
            </list>
        </field>
    </record>

    <record id="production_supervisor_view_form" model="ir.ui.view">
        <field name="name">production.supervisor.form</field>
        <field name="model">production.supervisor</field>
        <field name="arch" type="xml">
            <form string="Üretim Sorumlusu">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="responsible_id" widget="many2one_avatar_employee"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="production_supervisor_action" model="ir.actions.act_window">
        <field name="name">Üretim Sorumluları</field>
        <field name="res_model">production.supervisor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
