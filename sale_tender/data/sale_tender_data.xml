<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- İhale satış türü: ihale teklifleri için standart tür kaydı.
             Mevcut "İhale" türü varsa bu kayıt pasifleştirilebilir veya
             mevcut kayıtla birleştirilebilir. -->
        <record id="sale_order_type_tender" model="sale.order.type">
            <field name="name">İhale</field>
            <field name="journal_id"
                   search="[('type', '=', 'sale'), ('company_id', '=', ref('base.main_company'))]"/>
        </record>

        <!-- Varsayılan ihale kayıt nedenleri -->
        <record id="lost_reason_price" model="sale.tender.lost.reason">
            <field name="name">Fiyat nedeniyle kaybedildi</field>
            <field name="sequence" eval="10"/>
        </record>
        <record id="lost_reason_technical" model="sale.tender.lost.reason">
            <field name="name">Teknik şartnameye uyulamadı</field>
            <field name="sequence" eval="20"/>
        </record>
        <record id="lost_reason_delivery" model="sale.tender.lost.reason">
            <field name="name">Teslim süresi uygun değildi</field>
            <field name="sequence" eval="30"/>
        </record>
        <record id="lost_reason_documents" model="sale.tender.lost.reason">
            <field name="name">İdari / eksik evrak</field>
            <field name="sequence" eval="40"/>
        </record>
        <record id="lost_reason_other" model="sale.tender.lost.reason">
            <field name="name">Diğer</field>
            <field name="sequence" eval="50"/>
        </record>
    </data>
</odoo>
