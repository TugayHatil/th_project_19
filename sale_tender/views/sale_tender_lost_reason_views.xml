<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_tender_lost_reason_list" model="ir.ui.view">
        <field name="name">sale.tender.lost.reason.list</field>
        <field name="model">sale.tender.lost.reason</field>
        <field name="arch" type="xml">
            <list string="İhale Kayıt Nedenleri" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_sale_tender_lost_reason" model="ir.actions.act_window">
        <field name="name">İhale Kayıt Nedenleri</field>
        <field name="res_model">sale.tender.lost.reason</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
