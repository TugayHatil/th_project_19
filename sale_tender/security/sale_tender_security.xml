<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- İhale yönetimi yetki grubu (kullanıcı formunda seçim olarak görünür) -->
    <record id="module_category_sale_tender" model="ir.module.category">
        <field name="name">İhale Yönetimi</field>
        <field name="sequence">30</field>
    </record>
    <record id="res_groups_privilege_sale_tender" model="res.groups.privilege">
        <field name="name">İhale Yönetimi</field>
        <field name="category_id" ref="sale_tender.module_category_sale_tender"/>
        <field name="sequence">30</field>
    </record>

    <!-- İhale Kullanıcısı: ihaleleri ve bağlı teklifleri görüntüleyebilir,
         ihale kayıtlarını oluşturamaz/düzenleyemez/silemez -->
    <record id="group_tender_user" model="res.groups">
        <field name="name">İhale Kullanıcısı</field>
        <field name="comment">İhale kayıtlarını ve bağlı satış tekliflerini görüntüleme yetkisi.</field>
        <field name="privilege_id" ref="sale_tender.res_groups_privilege_sale_tender"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <!-- İhale Yöneticisi: tam yetki -->
    <record id="group_tender_manager" model="res.groups">
        <field name="name">İhale Yöneticisi</field>
        <field name="comment">İhale kayıtlarını oluşturma, düzenleme, durum değiştirme, doküman ekleme ve teklif oluşturma yetkisi.</field>
        <field name="privilege_id" ref="sale_tender.res_groups_privilege_sale_tender"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('sale_tender.group_tender_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Çoklu şirket: tüm gruplar için global kural -->
    <record id="rule_sale_tender_company" model="ir.rule">
        <field name="name">İhale: şirket sınırı</field>
        <field name="model_id" ref="model_sale_tender"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
