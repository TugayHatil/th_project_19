<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_tender_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>
                    <span>İhale</span>
                    <span t-field="doc.display_name"/>
                </h2>

                <div id="informations" class="row mt-4 mb-4">
                    <div class="col" t-if="doc.tender_no">
                        <strong>İhale Numarası</strong>
                        <div t-field="doc.tender_no"/>
                    </div>
                    <div class="col" t-if="doc.partner_id">
                        <strong>Müşteri</strong>
                        <div t-field="doc.partner_id"/>
                    </div>
                    <div class="col" t-if="doc.tender_date">
                        <strong>İhale Tarihi</strong>
                        <div t-field="doc.tender_date"/>
                    </div>
                    <div class="col" t-if="doc.bid_deadline">
                        <strong>Son Teklif Tarihi</strong>
                        <div t-field="doc.bid_deadline"/>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col" t-if="doc.user_id">
                        <strong>Sorumlu</strong>
                        <div t-field="doc.user_id"/>
                    </div>
                    <div class="col">
                        <strong>Durum</strong>
                        <div t-field="doc.state"/>
                    </div>
                    <div class="col" t-if="doc.competitor_ids">
                        <strong>Rakipler</strong>
                        <div>
                            <t t-foreach="doc.competitor_ids" t-as="comp">
                                <span t-field="comp.name"/><t t-if="not comp_last">, </t>
                            </t>
                        </div>
                    </div>
                    <div class="col" t-if="doc.state == 'lost' and doc.lost_reason_id">
                        <strong>Kayıt Nedeni</strong>
                        <div t-field="doc.lost_reason_id"/>
                    </div>
                </div>

                <t t-if="doc.description">
                    <h4>Açıklama</h4>
                    <p t-field="doc.description" style="white-space: pre-wrap;"/>
                </t>

                <t t-set="orders" t-value="env['sale.order'].with_context(active_test=False).search([('tender_id', '=', doc.id)], order='date_order, name')"/>
                <t t-if="orders">
                    <h4>Teklifler</h4>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Teklif No</th>
                                <th>Müşteri</th>
                                <th>Tarih</th>
                                <th>Satış Türü</th>
                                <th class="text-end">Tutar</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="orders" t-as="order">
                                <td t-field="order.name"/>
                                <td t-field="order.partner_id"/>
                                <td t-field="order.date_order"/>
                                <td t-field="order.so_type_id"/>
                                <td class="text-end" t-field="order.amount_total"/>
                                <td t-field="order.state"/>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>
</odoo>
