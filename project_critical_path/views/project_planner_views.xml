<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_project_planner_workspace" model="ir.actions.client">
        <field name="name">Planner</field>
        <field name="tag">project_critical_path.planner_workspace</field>
    </record>

    <record id="project_project_form_inherit_planner_workspace" model="ir.ui.view">
        <field name="name">project.project.form.inherit.planner.workspace</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_planner_workspace"
                        string="Planner"
                        type="object"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_project_planner_workspace"
              name="Planner"
              parent="project.menu_main_pm"
              action="action_project_planner_workspace"
              sequence="30"/>

    <!-- Dedicated search view for the Planner workspace (BRD): standard
         Filters / Group By / Favorites on project.task. -->
    <record id="project_task_planner_search" model="ir.ui.view">
        <field name="name">project.task.planner.search</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_ids"/>
                <field name="stage_id"/>
                <field name="wbs_code"/>
                <field name="date_assign"/>
                <field name="date_deadline"/>
                <filter name="filter_critical" string="Critical Tasks"
                        domain="[('is_critical', '=', True)]"/>
                <filter name="filter_delayed" string="Delayed Tasks"
                        domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', '!=', '1_done')]"/>
                <filter name="filter_this_week" string="This Week"
                        domain="[('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date_deadline', '&lt;', (context_today() + relativedelta(days=(7 - context_today().weekday()))).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_completed" string="Completed Tasks"
                        domain="[('state', '=', '1_done')]"/>
                <separator/>
                <filter name="group_project" string="Project"
                        context="{'group_by': 'project_id'}"/>
                <filter name="group_stage" string="Stage"
                        context="{'group_by': 'stage_id'}"/>
                <filter name="group_assignees" string="Assignees"
                        context="{'group_by': 'user_ids'}"/>
                <filter name="group_wbs_level" string="WBS Level"
                        context="{'group_by': 'wbs_level'}"/>
            </search>
        </field>
    </record>
</odoo>
