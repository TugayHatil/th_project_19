<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Orphan cleanup: records from the removed Material Requirement
         feature stay in the DB after its XML file is dropped — delete
         them before the project form inherit is re-validated (the old
         button calls a method that no longer exists). -->
    <delete model="ir.ui.view" id="project_project_form_inherit_material_requirement"/>
    <delete model="ir.ui.view" id="project_material_requirement_list"/>
    <delete model="ir.ui.view" id="project_material_requirement_form"/>
    <delete model="ir.ui.view" id="project_material_requirement_search"/>
    <delete model="ir.actions.act_window" id="action_project_material_requirement"/>
    <delete model="ir.ui.menu" id="menu_project_material_requirement"/>
    <delete model="ir.model.access" id="access_project_material_requirement_user"/>

    <!-- Orphan cleanup: these records moved to project_resource_planning.
         Odoo does not remove module data on upgrade, so the old copies
         would stay active — an inherited view calling a method that no
         longer exists on the model breaks form rendering/validation.
         The addon recreates the same XML IDs under its own namespace. -->
    <delete model="ir.ui.view" id="project_project_form_inherit_material_plan"/>
    <delete model="ir.ui.view" id="stock_picking_form_inherit_material_plan"/>
    <delete model="ir.ui.view" id="project_material_plan_list"/>
    <delete model="ir.ui.view" id="project_material_plan_form"/>
    <delete model="ir.ui.view" id="project_material_plan_search"/>
    <delete model="ir.actions.act_window" id="action_project_material_plan"/>
    <delete model="ir.actions.server" id="action_material_plan_approve"/>
    <delete model="ir.ui.menu" id="menu_project_material_plan"/>
    <delete model="ir.ui.view" id="project_resource_role_list"/>
    <delete model="ir.ui.view" id="project_resource_role_form"/>
    <delete model="ir.actions.act_window" id="action_project_resource_role"/>
    <delete model="ir.ui.menu" id="menu_project_resource_role"/>
    <delete model="ir.ui.view" id="project_resource_rate_template_list"/>
    <delete model="ir.ui.view" id="project_resource_rate_template_form"/>
    <delete model="ir.actions.act_window" id="action_project_resource_rate_template"/>
    <delete model="ir.ui.menu" id="menu_project_resource_rate_template"/>
    <delete model="ir.ui.view" id="project_task_resource_assignment_list"/>
    <delete model="ir.ui.view" id="project_task_resource_assignment_form"/>
    <delete model="ir.ui.view" id="hr_employee_form_inherit_resource_roles"/>
    <delete model="ir.ui.view" id="project_resource_planner_form"/>
    <delete model="ir.ui.view" id="project_task_resource_assignment_gantt_employee"/>
    <delete model="ir.ui.view" id="project_task_resource_assignment_gantt_equipment"/>
    <delete model="ir.model.access" id="access_project_resource_role_user"/>
    <delete model="ir.model.access" id="access_project_task_resource_requirement_user"/>
    <delete model="ir.model.access" id="access_project_resource_plan_summary_user"/>
    <delete model="ir.model.access" id="access_project_task_resource_assignment_user"/>
    <delete model="ir.model.access" id="access_project_resource_planner_user"/>
    <delete model="ir.model.access" id="access_project_resource_planner_line_user"/>
    <delete model="ir.model.access" id="access_project_resource_rate_template_user"/>
    <delete model="ir.model.access" id="access_project_material_plan_user"/>

    <record id="project_project_form_inherit_critical_path" model="ir.ui.view">
        <field name="name">project.project.form.inherit.critical.path</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_calculate_critical_paths"
                        string="Calculate Critical Paths"
                        type="object"
                        class="btn-secondary"
                        groups="project.group_project_manager"/>
                <button name="action_create_critical_path_baseline"
                        string="Create Baseline"
                        type="object"
                        class="btn-secondary"
                        groups="project.group_project_manager"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="wbs_structure" string="Work Breakdown Structure">
                    <field name="task_ids" nolabel="1" context="{'default_project_id': id}">
                        <list string="Work Breakdown Structure" default_order="wbs_sort_key asc">
                            <field name="wbs_code" string="WBS"/>



                            <field name="wbs_level" string="Level" optional="hide"/>
                            <field name="name" string="Task Title"/>
                            <field name="user_ids" widget="many2many_tags" optional="show"/>
                            <field name="is_work_package" string="Work Package" optional="show"/>
                            <field name="allocated_hours" string="Planned Hours" optional="show"/>
                            <field name="effective_hours" string="Actual Hours" optional="show"/>
                            <field name="progress" string="Progress (%)" optional="show"/>
                            <field name="planned_hours_rollup" string="Planned Roll-up"/>
                            <field name="effective_hours_rollup" string="Actual Roll-up"/>
                            <field name="progress_rollup" string="Progress Roll-up (%)"/>
                            <field name="stage_id" optional="show"/>
                        </list>
                    </field>
                </page>
                <page name="critical_paths" string="Critical Paths">

                    <group>
                        <group>
                            <field name="critical_path_count"/>
                        </group>
                        <group>
                            <field name="critical_path_duration" widget="float_time"/>
                        </group>
                    </group>
                    <field name="critical_path_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="task_path"/>
                            <field name="duration" widget="float_time"/>
                        </list>
                    </field>
                </page>
                <page name="critical_path_baselines" string="Plan Baselines">
                    <group>
                        <group>
                            <field name="critical_path_baseline_count"/>
                        </group>
                        <group>
                            <button name="action_view_critical_path_baselines"
                                    string="View Baselines" type="object"
                                    class="btn-secondary"/>
                        </group>
                    </group>
                    <field name="critical_path_baseline_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="created_on"/>
                            <field name="created_by_id"/>
                            <field name="project_duration" widget="float_time"/>
                            <field name="critical_path_duration" widget="float_time"/>
                            <field name="history_project_duration_variance" widget="float_time"/>
                            <field name="history_critical_path_duration_variance" widget="float_time"/>
                            <field name="history_critical_path_changed"/>
                            <field name="history_added_task_names" optional="hide"/>
                            <field name="history_removed_task_names" optional="hide"/>
                            <field name="critical_path_changed"/>
                        </list>
                    </field>
                </page>
                <page name="task_delay_impact" string="Delay Impact">
                    <group string="Project Impact Summary">
                        <group>
                            <field name="delay_impact_baseline_id"/>
                            <field name="delay_baseline_duration" widget="float_time"/>
                        </group>
                        <group>
                            <field name="delay_current_duration" widget="float_time"/>
                            <field name="delay_total" widget="float_time"/>
                        </group>
                    </group>
                    <field name="delay_impact_line_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="task_id"/>
                            <field name="baseline_duration" widget="float_time"/>
                            <field name="current_duration" widget="float_time"/>
                            <field name="duration_variance" widget="float_time"/>
                            <field name="project_impact" widget="float_time"/>
                            <field name="impact_status"/>
                            <field name="impact_chain"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="project_task_form_inherit_critical_path" model="ir.ui.view">
        <field name="name">project.task.form.inherit.critical.path</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/.." position="before">
                <div class="o_row mb-2" invisible="not wbs_code">
                    <span class="badge rounded-pill text-bg-info me-1">WBS: <field name="wbs_code" readonly="1"/></span>
                    <span class="badge rounded-pill text-bg-secondary me-1">Level: <field name="wbs_level" readonly="1"/></span>
                    <span class="badge rounded-pill text-bg-warning" invisible="not is_work_package">Work Package</span>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">

                <page name="critical_path_schedule" string="Critical Path Schedule">
                    <group>
                        <group string="Early Dates">
                            <field name="critical_early_start"/>
                            <field name="critical_early_finish"/>
                        </group>
                        <group string="Late Dates">
                            <field name="critical_late_start"/>
                            <field name="critical_late_finish"/>
                            <field name="critical_slack"/>
                            <field name="is_critical"/>
                        </group>
                    </group>
                    <group string="Delay Impact Analysis">
                        <group>
                            <field name="delay_baseline_duration"/>
                            <field name="allocated_hours"/>
                            <field name="delay_duration_variance"/>
                        </group>
                        <group>
                            <field name="delay_project_impact"/>
                            <field name="delay_impact_status"/>
                            <field name="delay_impact_chain"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_task_list_inherit_critical_path" model="ir.ui.view">
        <field name="name">project.task.list.inherit.critical.path</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">wbs_sort_key asc</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="wbs_code" string="WBS"/>
                <field name="wbs_level" string="Level" optional="hide"/>
                <field name="is_work_package" string="Work Package" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="planned_hours_rollup" string="Planned Roll-up" optional="show"/>
                <field name="effective_hours_rollup" string="Actual Roll-up" optional="show"/>
                <field name="progress_rollup" string="Progress Roll-up (%)" optional="show"/>
                <field name="is_critical" optional="hide"/>
                <field name="critical_slack" optional="hide"/>
                <field name="delay_project_impact" optional="hide"/>
                <field name="delay_impact_status" optional="hide"/>
            </xpath>
        </field>
    </record>


    <record id="project_task_search_inherit_wbs" model="ir.ui.view">
        <field name="name">project.task.search.inherit.wbs</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="wbs_code" string="WBS Code"/>
                <field name="wbs_level" string="WBS Level"/>
            </xpath>
            <xpath expr="//filter[@name='my_tasks']" position="before">
                <filter string="Work Packages" name="filter_work_package" domain="[('is_work_package', '=', True)]"/>
                <filter string="Root Tasks (WBS L1)" name="filter_wbs_root" domain="[('wbs_level', '=', 1)]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="WBS Code" name="group_by_wbs_code" context="{'group_by': 'wbs_code'}"/>
                <filter string="WBS Level" name="group_by_wbs_level" context="{'group_by': 'wbs_level'}"/>
                <filter string="Parent Work Package" name="group_by_parent_id" context="{'group_by': 'parent_id'}"/>
            </xpath>

        </field>
    </record>


    <record id="project_critical_path_baseline_list" model="ir.ui.view">
        <field name="name">project.critical.path.baseline.list</field>
        <field name="model">project.critical.path.baseline</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="project_id"/>
                <field name="created_on"/>
                <field name="created_by_id"/>
                <field name="project_duration" widget="float_time"/>
                <field name="critical_path_duration" widget="float_time"/>
                <field name="planned_resource_cost"/>
                <field name="history_planned_cost_variance" string="Cost Change"/>
                <field name="critical_path_changed"/>
            </list>
        </field>
    </record>

    <record id="project_critical_path_baseline_form" model="ir.ui.view">
        <field name="name">project.critical.path.baseline.form</field>
        <field name="model">project.critical.path.baseline</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Baseline">
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="created_on"/>
                            <field name="created_by_id"/>
                        </group>
                        <group string="Planned Resource Cost">
                            <field name="currency_id"/>
                            <field name="planned_resource_hours" widget="float_time"/>
                            <field name="planned_resource_cost"/>
                        </group>
                        <group string="Current Plan Comparison">
                            <field name="project_duration" widget="float_time"/>
                            <field name="current_project_duration" widget="float_time"/>
                            <field name="project_duration_delta" widget="float_time"/>
                            <field name="critical_path_duration" widget="float_time"/>
                            <field name="current_critical_path_duration" widget="float_time"/>
                            <field name="critical_path_duration_delta" widget="float_time"/>
                            <field name="critical_path_changed"/>
                        </group>
                    </group>
                    <group string="Previous Baseline Comparison">
                        <group>
                            <field name="previous_baseline_id"/>
                            <field name="history_project_duration_variance" widget="float_time"/>
                            <field name="history_critical_path_duration_variance" widget="float_time"/>
                            <field name="history_planned_cost_variance"/>
                        </group>
                        <group>
                            <field name="history_critical_path_changed"/>
                            <field name="history_added_task_names"/>
                            <field name="history_removed_task_names"/>
                        </group>
                    </group>
                    <group string="Previous Baseline Change Summary">
                        <field name="history_change_summary" nolabel="1"/>
                    </group>
                    <group string="Critical Path Comparison">
                            <field name="critical_path_signature" nolabel="1"/>
                            <field name="current_critical_path_signature" nolabel="1"/>
                        </group>
                        <group string="Critical Path Change Analysis">
                            <field name="critical_path_changed"/>
                            <field name="critical_path_change_summary" nolabel="1"/>
                        </group>
                        <field name="critical_path_change_line_ids" nolabel="1">
                            <list create="0" edit="0" delete="0">
                                <field name="task_name"/>
                                <field name="baseline_is_critical"/>
                                <field name="current_is_critical"/>
                                <field name="change_type"/>
                            </list>
                        </field>
                    <field name="line_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="task_name"/>
                            <field name="parent_task_name" optional="hide"/>
                            <field name="allocated_hours" widget="float_time"/>
                            <field name="current_allocated_hours" widget="float_time"/>
                            <field name="allocated_hours_delta" widget="float_time"/>
                            <field name="planned_hours" widget="float_time" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="planned_cost" optional="show"/>
                            <field name="early_start" optional="hide"/>
                            <field name="early_finish" optional="hide"/>
                            <field name="late_start" optional="hide"/>
                            <field name="late_finish" optional="hide"/>
                            <field name="slack"/>
                            <field name="is_critical"/>
                            <field name="current_slack" optional="hide"/>
                            <field name="current_is_critical"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- BRD-22: one-click Kanban → Planner shortcut on every project card.
         The link calls the same action as the form's Planner button, so
         both entries land in the same planner workspace. -->
    <record id="project_project_kanban_inherit_planner" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.critical.path</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_project_kanban_boxes')]" position="inside">
                <a class="o_project_kanban_box ms-1" name="action_open_planner_workspace" type="object">
                    <div><i class="fa fa-calendar me-1"/>Planner</div>
                </a>
            </xpath>
        </field>
    </record>
</odoo>
