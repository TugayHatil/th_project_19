<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         MATERIAL PLAN  (BRD: Material Plan → Odoo Stock)
         Taslak → Onaylı lifecycle. Approval creates standard
         stock.picking / stock.move grouped by source+destination.
         ════════════════════════════════════════════════════════════════ -->
    <record id="project_material_plan_list" model="ir.ui.view">
        <field name="name">project.material.plan.list</field>
        <field name="model">project.material.plan</field>
        <field name="arch" type="xml">
            <list string="Material Plan" editable="bottom"
                  decoration-warning="state == 'draft'"
                  decoration-info="state == 'approved'">
                <field name="task_id" readonly="state == 'approved'"/>
                <field name="product_id" readonly="state == 'approved'"/>
                <field name="planned_quantity" readonly="state == 'approved'"/>
                <field name="uom_id" readonly="state == 'approved'"/>
                <field name="required_date" readonly="state == 'approved'"/>
                <field name="source_location_id" readonly="state == 'approved'" optional="show"/>
                <field name="destination_location_id" readonly="state == 'approved'" optional="show"/>
                <field name="picking_ids" widget="many2many_tags" readonly="1" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'approved'"/>
                <field name="planned_cost" sum="Total" optional="hide" readonly="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="project_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="project_material_plan_form" model="ir.ui.view">
        <field name="name">project.material.plan.form</field>
        <field name="model">project.material.plan</field>
        <field name="arch" type="xml">
            <form string="Material Plan">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_transfers" string="Open Transfer"
                            type="object" class="btn-secondary"
                            invisible="state != 'approved' or not picking_ids"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" readonly="state == 'approved'"/>
                            <field name="task_id" readonly="state == 'approved'"/>
                            <field name="wbs_code" readonly="1" invisible="not wbs_code"/>
                            <field name="product_id" readonly="state == 'approved'"/>
                            <field name="description" readonly="state == 'approved'"/>
                        </group>
                        <group>
                            <field name="planned_quantity" readonly="state == 'approved'"/>
                            <field name="uom_id" readonly="state == 'approved'"/>
                            <field name="required_date" readonly="state == 'approved'"/>
                            <field name="unit_cost" readonly="1"/>
                            <field name="planned_cost" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Stock Transfer">
                        <group>
                            <field name="source_location_id" readonly="state == 'approved'"/>
                            <field name="destination_location_id" readonly="state == 'approved'"/>
                        </group>
                        <group>
                            <field name="picking_ids" widget="many2many_tags" readonly="1"
                                   invisible="not picking_ids"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="notes" string="Notes">
                            <field name="notes" readonly="state == 'approved'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_material_plan_search" model="ir.ui.view">
        <field name="name">project.material.plan.search</field>
        <field name="model">project.material.plan</field>
        <field name="arch" type="xml">
            <search string="Material Plan">
                <field name="product_id"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="filter_required_passed" string="Required Date Passed"
                        domain="[('required_date', '&lt;', 'today')]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_task" string="Task / WBS" context="{'group_by': 'task_id'}"/>
                    <filter name="group_parent" string="WBS / Parent" context="{'group_by': 'parent_task_id'}"/>
                    <filter name="group_source" string="Source Location" context="{'group_by': 'source_location_id'}"/>
                    <filter name="group_destination" string="Destination Location" context="{'group_by': 'destination_location_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_required_date" string="Required Date" context="{'group_by': 'required_date'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_project_material_plan" model="ir.actions.act_window">
        <field name="name">Material Plan</field>
        <field name="res_model">project.material.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="project_material_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Plan the materials this project needs
            </p>
            <p>
                Each line links a product to a task with a required date.
                Approving draft lines creates a standard Odoo stock transfer —
                reservation and replenishment are handled by Odoo.
            </p>
        </field>
    </record>

    <!-- Traceability back: picking form shows its source plan lines -->
    <record id="stock_picking_form_inherit_material_plan" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.material.plan</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="material_plan_line_ids" widget="many2many_tags"
                       readonly="1" invisible="not material_plan_line_ids"/>
            </xpath>
        </field>
    </record>

    <!-- Multi-select approval: ⚙ Action → Approve on the list view -->
    <record id="action_material_plan_approve" model="ir.actions.server">
        <field name="name">Approve</field>
        <field name="model_id" ref="project_critical_path.model_project_material_plan"/>
        <field name="binding_model_id" ref="project_critical_path.model_project_material_plan"/>
        <field name="state">code</field>
        <field name="code">records.action_approve()</field>
    </record>

    <menuitem id="menu_project_material_plan"
              name="Material Plan"
              parent="project.menu_project_config"
              action="action_project_material_plan"
              sequence="50"/>
</odoo>
