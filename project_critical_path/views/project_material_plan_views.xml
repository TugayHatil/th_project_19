<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Material Plan (BRD): a single standard list view per project.
         Stock/Purchase/MRP columns intentionally omitted — that is a
         later phase; the plan itself stays product × task × quantity. -->
    <record id="project_material_plan_list" model="ir.ui.view">
        <field name="name">project.material.plan.list</field>
        <field name="model">project.material.plan</field>
        <field name="arch" type="xml">
            <list string="Material Plan" editable="bottom">
                <field name="project_id" column_invisible="1"/>
                <field name="task_id" domain="[('project_id', '=', project_id)]"/>
                <field name="product_id"/>
                <field name="planned_quantity" sum="Total"/>
                <field name="uom_id" optional="show"/>
                <field name="required_date"/>
                <field name="description" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="planned_cost" optional="hide" sum="Total Cost"/>
            </list>
        </field>
    </record>

    <record id="project_material_plan_form" model="ir.ui.view">
        <field name="name">project.material.plan.form</field>
        <field name="model">project.material.plan</field>
        <field name="arch" type="xml">
            <form string="Material Plan Line">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="task_id" domain="[('project_id', '=', project_id)]"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="planned_quantity"/>
                            <field name="uom_id" domain="[('category_id', '=', product_uom_category_id)]"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="required_date"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="description" placeholder="e.g. installation cable run"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="unit_cost" readonly="1"/>
                        <field name="planned_cost" readonly="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_material_plan_search" model="ir.ui.view">
        <field name="name">project.material.plan.search</field>
        <field name="model">project.material.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="task_id"/>
                <field name="product_id"/>
                <field name="required_date"/>
                <field name="planned_quantity"/>
                <separator/>
                <filter name="filter_required_this_week" string="Required This Week"
                        domain="[('required_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('required_date', '&lt;', (context_today() + relativedelta(days=(7 - context_today().weekday()))).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_required_past" string="Required Date Passed"
                        domain="[('required_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_task" string="Task / WBS"
                        context="{'group_by': 'task_id'}"/>
                <filter name="group_parent" string="WBS / Parent"
                        context="{'group_by': 'parent_task_id'}"/>
                <filter name="group_product" string="Product"
                        context="{'group_by': 'product_id'}"/>
                <filter name="group_required_date" string="Required Date"
                        context="{'group_by': 'required_date'}"/>
                <filter name="group_project" string="Project"
                        context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_project_material_plan" model="ir.actions.act_window">
        <field name="name">Material Plan</field>
        <field name="res_model">project.material.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Project form header: sits next to the Planner button, same level. -->
    <record id="project_project_form_inherit_material_plan" model="ir.ui.view">
        <field name="name">project.project.form.inherit.material.plan</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_open_planner_workspace']" position="after">
                <button name="action_open_material_plan"
                        string="Material Plan"
                        type="object"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_project_material_plan"
              name="Material Plans"
              parent="project.menu_main_pm"
              action="action_project_material_plan"
              sequence="35"/>
</odoo>
