<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Material Requirement (BRD phase 2): read-only consolidated view of
         the Material Plan against live stock. The model is a SQL view — no
         create/edit/delete, quantities and status are computed columns so
         standard Filters / Group By work on them. -->
    <record id="project_material_requirement_list" model="ir.ui.view">
        <field name="name">project.material.requirement.list</field>
        <field name="model">project.material.requirement</field>
        <field name="arch" type="xml">
            <list string="Material Requirements"
                  create="0" edit="0" delete="0"
                  decoration-danger="status == 'not_available'"
                  decoration-warning="status == 'partially_available'"
                  decoration-success="status == 'available'">
                <field name="product_id"/>
                <field name="planned_quantity" sum="Total Planned"/>
                <field name="available_quantity" sum="Total Available"/>
                <field name="shortage_quantity" sum="Total Shortage"/>
                <field name="uom_id"/>
                <field name="required_date"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'not_available'"
                       decoration-warning="status == 'partially_available'"
                       decoration-success="status == 'available'"/>
                <field name="project_id" optional="hide"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="project_material_requirement_form" model="ir.ui.view">
        <field name="name">project.material.requirement.form</field>
        <field name="model">project.material.requirement</field>
        <field name="arch" type="xml">
            <form string="Material Requirement" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="status" widget="badge"
                               decoration-danger="status == 'not_available'"
                               decoration-warning="status == 'partially_available'"
                               decoration-success="status == 'available'"/>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="required_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="planned_quantity" readonly="1"/>
                            <field name="available_quantity" readonly="1"/>
                            <field name="shortage_quantity" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Source Material Plan Lines">
                        <field name="material_plan_line_ids" nolabel="1" readonly="1">
                            <list editable="0" create="0" delete="0">
                                <field name="task_id"/>
                                <field name="planned_quantity"/>
                                <field name="uom_id"/>
                                <field name="required_date"/>
                                <field name="description" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_material_requirement_search" model="ir.ui.view">
        <field name="name">project.material.requirement.search</field>
        <field name="model">project.material.requirement</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="project_id"/>
                <field name="required_date"/>
                <separator/>
                <filter name="filter_not_available" string="Not Available"
                        domain="[('status', '=', 'not_available')]"/>
                <filter name="filter_partially_available" string="Partially Available"
                        domain="[('status', '=', 'partially_available')]"/>
                <filter name="filter_available" string="Available"
                        domain="[('status', '=', 'available')]"/>
                <separator/>
                <filter name="filter_required_this_week" string="Required This Week"
                        domain="[('required_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('required_date', '&lt;', (context_today() + relativedelta(days=(7 - context_today().weekday()))).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_required_past" string="Required Date Passed"
                        domain="[('required_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_product" string="Product"
                        context="{'group_by': 'product_id'}"/>
                <filter name="group_status" string="Status"
                        context="{'group_by': 'status'}"/>
                <filter name="group_required_date" string="Required Date"
                        context="{'group_by': 'required_date'}"/>
                <filter name="group_project" string="Project"
                        context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_project_material_requirement" model="ir.actions.act_window">
        <field name="name">Material Requirements</field>
        <field name="res_model">project.material.requirement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Project form header: next to the Material Plan button. -->
    <record id="project_project_form_inherit_material_requirement" model="ir.ui.view">
        <field name="name">project.project.form.inherit.material.requirement</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_open_material_plan']" position="after">
                <button name="action_open_material_requirement"
                        string="Material Requirement"
                        type="object"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_project_material_requirement"
              name="Material Requirements"
              parent="project.menu_main_pm"
              action="action_project_material_requirement"
              sequence="36"/>
</odoo>
