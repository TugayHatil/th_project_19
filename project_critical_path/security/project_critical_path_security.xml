<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Planner Manager (BRD): members edit the Planner workspace —
         dates, dependencies, WBS, baselines. Everyone else is read-only. -->
    <record id="res_groups_privilege_planner" model="res.groups.privilege">
        <field name="name">Planner</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_planner_manager" model="res.groups">
        <field name="name">Planner Manager</field>
        <field name="comment">Planner Manager: can modify planner data — dates, dependencies, WBS hierarchy and baselines. Non-members get a read-only Planner.</field>
        <field name="privilege_id" ref="res_groups_privilege_planner"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
