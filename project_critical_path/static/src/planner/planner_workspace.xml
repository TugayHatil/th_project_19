<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="project_critical_path.PlannerWorkspace">
        <div class="o_cp_planner_workspace d-flex flex-column h-100">
            <div class="o_cp_planner_toolbar d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                <span class="fw-bold">Planner</span>
                <t t-if="state.projects.length &amp;&amp; !props.action?.params?.project_id">
                    <select class="form-select form-select-sm w-auto"
                            t-on-change="onProjectChange">
                        <option value="">Select a project…</option>
                        <t t-foreach="state.projects" t-as="project" t-key="project.id">
                            <option t-att-value="project.id"
                                    t-att-selected="project.id === state.projectId"
                                    t-esc="project.name"/>
                        </t>
                    </select>
                </t>
                <t t-else="">
                    <span class="text-muted" t-esc="state.projectName"/>
                </t>
                <div class="btn-group ms-3">
                    <t t-foreach="['day', 'week', 'month']" t-as="scale" t-key="scale">
                        <button type="button"
                                class="btn btn-sm"
                                t-att-class="state.scale === scale ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.setScale(scale)"
                                t-esc="scales[scale].label"/>
                    </t>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="goToday">Today</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="fit">Fit</button>
                <button type="button" class="btn btn-sm"
                        t-att-class="state.historyOpen ? 'btn-primary' : 'btn-outline-secondary'"
                        t-on-click="toggleHistory">Baseline History</button>
                <div class="o_cp_planner_colmenu position-relative">
                    <button type="button" class="btn btn-sm"
                            t-att-class="state.showStartCol || state.showFinishCol ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => state.colMenuOpen = !state.colMenuOpen">
                        Columns <i class="fa fa-caret-down"/>
                    </button>
                    <div t-if="state.colMenuOpen" class="o_cp_planner_colmenu_pop border rounded shadow-sm bg-white p-2">
                        <label class="d-flex align-items-center gap-2 small mb-1">
                            <input type="checkbox" t-att-checked="state.showStartCol"
                                   t-on-change="() => state.showStartCol = !state.showStartCol"/>
                            Start
                        </label>
                        <label class="d-flex align-items-center gap-2 small mb-0">
                            <input type="checkbox" t-att-checked="state.showFinishCol"
                                   t-on-change="() => state.showFinishCol = !state.showFinishCol"/>
                            Finish
                        </label>
                    </div>
                </div>
            </div>
            <div class="o_cp_planner_body d-flex flex-grow-1 overflow-hidden">
                <div class="o_cp_planner_wbs d-flex flex-column border-end"
                     t-att-style="'width:' + wbsPanelWidth + 'px;flex-basis:' + wbsPanelWidth + 'px'">
                    <div class="o_cp_planner_wbs_header d-flex align-items-center px-2 border-bottom fw-bold">
                        <span class="o_cp_planner_toggle"/>
                        <span class="o_cp_planner_wbs_code me-2">WBS</span>
                        <span>Task</span>
                        <span t-if="state.showStartCol" class="o_cp_planner_date_col ms-auto">Start</span>
                        <span t-if="state.showFinishCol" class="o_cp_planner_date_col"
                              t-att-class="{'ms-auto': !state.showStartCol}">Finish</span>
                    </div>
                    <div class="o_cp_planner_wbs_rows flex-grow-1 overflow-hidden" t-ref="wbsRows" t-on-scroll="onWbsScroll">
                        <div t-foreach="visibleTasks" t-as="task" t-key="task.id"
                             class="o_cp_planner_wbs_row d-flex align-items-center px-2"
                             t-att-class="{selected: state.selectedId === task.id, parent: task.has_children}"
                             t-on-click="() => this.selectTask(task)"
                             t-on-dblclick="() => this.openTask(task)">
                            <span class="o_cp_planner_toggle" t-on-click="(ev) => this.toggleCollapse(task, ev)">
                                <i t-if="task.has_children"
                                   class="fa fa-fw"
                                   t-att-class="state.collapsedIds.has(task.id) ? 'fa-caret-right' : 'fa-caret-down'"/>
                            </span>
                            <span class="o_cp_planner_wbs_code text-muted me-2" t-esc="task.wbs_code"/>
                            <span class="o_cp_planner_task_name text-truncate"
                                  t-att-style="'margin-left:' + (Math.max((task.wbs_level || 1) - 1, 0) * 18) + 'px'"
                                  t-esc="task.name"/>
                            <i t-if="task.is_critical"
                               class="fa fa-exclamation-triangle o_cp_planner_critical_icon"
                               t-att-class="{'ms-auto': !state.showStartCol &amp;&amp; !state.showFinishCol}"
                               title="Critical Path"/>
                            <span t-if="state.showStartCol" class="o_cp_planner_date_col ms-auto small"
                                  t-esc="formatColDate(currentDates(task).start)"/>
                            <span t-if="state.showFinishCol" class="o_cp_planner_date_col small"
                                  t-att-class="{'ms-auto': !state.showStartCol}"
                                  t-esc="formatColDate(currentDates(task).stop)"/>
                            <span class="o_cp_planner_rescell" role="button"
                                  t-att-class="{'ms-auto': !task.is_critical &amp;&amp; !state.showStartCol &amp;&amp; !state.showFinishCol}"
                                  t-att-title="resTooltip(task)"
                                  t-on-click="(ev) => this.openTaskResources(task, ev)">
                                <t t-if="task.resources &amp;&amp; (task.resources.human || task.resources.equipment)">
                                    <i class="fa fa-user"/><t t-esc="task.resources.human"/>
                                    <t t-if="task.resources.equipment">
                                        <i class="fa fa-wrench ms-1"/><t t-esc="task.resources.equipment"/>
                                    </t>
                                    <i t-if="task.resources.open"
                                       class="fa fa-exclamation-circle o_cp_planner_res_warn ms-1"
                                       title="Unassigned or partially assigned requirements"/>
                                </t>
                                <i t-else="" class="fa fa-plus"/>
                            </span>
                        </div>
                        <div t-if="!state.loading &amp;&amp; !visibleTasks.length" class="p-3 text-muted">No tasks</div>
                    </div>
                </div>
                <div class="o_cp_planner_gantt flex-grow-1 d-flex flex-column overflow-hidden">
                    <div class="o_cp_planner_gantt_scroll flex-grow-1" t-ref="ganttScroll" t-on-scroll="onGanttScroll">
                        <div class="o_cp_planner_gantt_inner position-relative"
                             t-att-style="'width:' + timelineWidth + 'px'">
                            <div class="o_cp_planner_gantt_header position-sticky top-0">
                                <div class="o_cp_planner_gantt_groups d-flex">
                                    <div t-foreach="columnGroups" t-as="group" t-key="group_index"
                                         class="o_cp_planner_gantt_group text-truncate"
                                         t-att-style="'width:' + group.width + 'px'"
                                         t-esc="group.label"/>
                                </div>
                                <div class="o_cp_planner_gantt_cols d-flex">
                                    <div t-foreach="columns" t-as="col" t-key="col_index"
                                         class="o_cp_planner_gantt_col text-center text-truncate"
                                         t-att-style="'width:' + (col.days * state.pxPerDay) + 'px'"
                                         t-esc="col.label"/>
                                </div>
                            </div>
                            <div class="o_cp_planner_gantt_rows">
                                <div t-foreach="visibleTasks" t-as="task" t-key="task.id"
                                     class="o_cp_planner_gantt_row"
                                     t-att-class="{selected: state.selectedId === task.id}"
                                     t-on-click="() => this.onRowClick(task)"
                                     t-on-dblclick="() => this.openTask(task)">
                                    <div t-if="task.baseline_start &amp;&amp; task.baseline_stop"
                                         class="o_cp_planner_baseline_bar"
                                         t-att-style="baselineStyle(task)"
                                         t-att-title="baselineTooltip(task)"/>
                                    <div t-if="task.date_start &amp;&amp; task.date_stop"
                                         class="o_cp_planner_bar"
                                         t-att-class="{selected: state.selectedId === task.id, critical: task.is_critical, dragging: state.drag?.taskId === task.id}"
                                         t-att-style="barStyle(task)"
                                         t-att-title="task.is_critical ? task.name + ' — Critical Path' : task.name"
                                         t-on-pointerdown="(ev) => this.onBarPointerDown(task, 'move', ev)"/>
                                    <div t-if="task.date_start &amp;&amp; task.date_stop &amp;&amp; task.baseline_stop &amp;&amp; task.date_stop &gt; task.baseline_stop"
                                         class="o_cp_planner_variance_bar"
                                         t-att-style="varianceStyle(task)"
                                         t-att-title="varianceTooltip(task)"
                                         t-on-pointerdown="(ev) => this.onBarPointerDown(task, 'move', ev)"/>
                                    <div t-if="task.date_start &amp;&amp; task.date_stop"
                                         class="o_cp_planner_grip o_cp_planner_grip_left"
                                         t-att-style="gripStyle(task, 'left')"
                                         title="Change start"
                                         t-on-pointerdown="(ev) => this.onBarPointerDown(task, 'left', ev)"/>
                                    <div t-if="task.date_start &amp;&amp; task.date_stop"
                                         class="o_cp_planner_bar_info"
                                         t-att-style="barInfoStyle(task)"
                                         t-esc="barInfoText(task)"/>
                                    <div t-if="task.date_start &amp;&amp; task.date_stop"
                                         class="o_cp_planner_grip o_cp_planner_grip_right"
                                         t-att-style="gripStyle(task, 'right')"
                                         title="Change finish"
                                         t-on-pointerdown="(ev) => this.onBarPointerDown(task, 'right', ev)"/>
                                </div>
                                <div t-if="dragTip" class="o_cp_planner_dragtip"
                                     t-att-style="dragTip.style" t-esc="dragTip.text"/>
                                <svg class="o_cp_planner_deps"
                                     t-att-width="timelineWidth"
                                     t-att-height="visibleTasks.length * 32">
                                    <t t-foreach="dependencyEdges" t-as="edge" t-key="edge.key">
                                        <path class="o_cp_planner_dep_line"
                                              t-att-class="{dim: edge.dim, highlight: edge.highlight, critical: edge.critical}"
                                              t-att-d="edge.d" fill="none"/>
                                        <path class="o_cp_planner_dep_arrow"
                                              t-att-class="{dim: edge.dim, highlight: edge.highlight, critical: edge.critical}"
                                              t-att-d="edge.arrowD"/>
                                    </t>
                                </svg>
                            </div>
                            <div class="o_cp_planner_today" t-att-style="'left:' + todayLeft + 'px'"/>
                        </div>
                    </div>
                </div>
                <div t-if="state.inspectorOpen" class="o_cp_planner_inspector d-flex flex-column border-start">
                    <div class="o_cp_planner_inspector_header px-3 pt-3 pb-2 border-bottom">
                        <div class="d-flex align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="o_cp_planner_wbs_code text-muted">WBS: <t t-esc="state.inspector?.wbs_code"/></span>
                                    <span t-if="state.inspector?.is_critical" class="badge o_cp_planner_critical_badge">
                                        <i class="fa fa-exclamation-triangle me-1"/>Critical Path
                                    </span>
                                </div>
                                <input type="text" class="form-control form-control-sm fw-bold"
                                       t-att-value="state.form?.name"
                                       t-on-change="(ev) => state.form.name = ev.target.value"/>
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-2"
                                    title="Close" t-on-click="closeInspector">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </div>
                    <div class="o_cp_planner_inspector_body flex-grow-1 overflow-auto px-3 py-2">
                        <div t-if="state.inspectorLoading" class="text-muted small p-2">Loading…</div>
                        <t t-else="">
                            <div class="o_cp_planner_inspector_section mb-3">
                                <div class="fw-bold small text-uppercase text-muted mb-2">Current Plan</div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <label class="o_cp_planner_inspector_label">Start</label>
                                    <input type="date" class="form-control form-control-sm"
                                           t-att-value="state.form?.date_start"
                                           t-on-change="onStartChange"/>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <label class="o_cp_planner_inspector_label">Finish</label>
                                    <input type="date" class="form-control form-control-sm"
                                           t-att-value="state.form?.date_stop"
                                           t-on-change="onStopChange"/>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <label class="o_cp_planner_inspector_label">Duration</label>
                                    <input type="number" min="0" step="1" class="form-control form-control-sm"
                                           t-att-value="state.form?.duration_days"
                                           t-on-change="onDurationChange"/>
                                    <span class="text-muted small">days</span>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <label class="o_cp_planner_inspector_label">Progress</label>
                                    <input type="number" min="0" max="100" class="form-control form-control-sm"
                                           t-att-value="state.form?.progress"
                                           t-on-change="(ev) => state.form.progress = Number(ev.target.value)"/>
                                    <span class="text-muted small">%</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <label class="o_cp_planner_inspector_label">Assignee</label>
                                    <select class="form-select form-select-sm"
                                            t-on-change="(ev) => state.form.user_id = Number(ev.target.value) || false">
                                        <option value="">—</option>
                                        <t t-foreach="state.options.users" t-as="user" t-key="user.id">
                                            <option t-att-value="user.id"
                                                    t-att-selected="user.id === state.form?.user_id"
                                                    t-esc="user.name"/>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="o_cp_planner_inspector_section mb-3">
                                <div class="fw-bold small text-uppercase text-muted mb-2">
                                    Baseline
                                    <span t-if="state.baseline?.name" class="badge bg-secondary ms-1"
                                          t-esc="state.baseline.name"/>
                                </div>
                                <t t-if="state.baseline?.has_line">
                                    <table class="o_cp_planner_baseline_table w-100 small">
                                        <thead>
                                            <tr class="text-muted">
                                                <th/>
                                                <th class="text-end">Baseline</th>
                                                <th class="text-end">Current</th>
                                                <th class="text-end">Variance</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="text-muted">Start</td>
                                                <td class="text-end" t-esc="formatDay(state.baseline.date_start)"/>
                                                <td class="text-end" t-esc="formatDay(state.form?.date_start)"/>
                                                <td class="text-end" t-att-class="varianceClass(baselineStartVariance)"
                                                    t-esc="formatDayVariance(baselineStartVariance)"/>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Finish</td>
                                                <td class="text-end" t-esc="formatDay(state.baseline.date_stop)"/>
                                                <td class="text-end" t-esc="formatDay(state.form?.date_stop)"/>
                                                <td class="text-end" t-att-class="varianceClass(baselineStopVariance)"
                                                    t-esc="formatDayVariance(baselineStopVariance)"/>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Duration</td>
                                                <td class="text-end" t-esc="formatDayCount(state.baseline.duration_days)"/>
                                                <td class="text-end" t-esc="formatDayCount(state.form?.duration_days)"/>
                                                <td class="text-end" t-att-class="varianceClass(baselineDurationVariance)"
                                                    t-esc="formatDayVariance(baselineDurationVariance)"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div class="d-flex justify-content-between small mt-2">
                                        <span class="text-muted">Total Delay</span>
                                        <span t-att-class="varianceClass(state.impact?.delay_project_impact)"
                                              t-att-title="state.impact?.delay_impact_chain || ''"
                                              t-esc="formatHours(state.impact?.delay_project_impact)"/>
                                    </div>
                                    <div class="d-flex justify-content-between small">
                                        <span class="text-muted">Impact</span>
                                        <span t-esc="impactStatusLabel"/>
                                    </div>
                                </t>
                                <div t-else="" class="text-muted small fst-italic">
                                    <t t-if="state.baseline?.name">Task was not part of <t t-esc="state.baseline.name"/>.</t>
                                    <t t-else="">No baseline exists for this project yet.</t>
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-2"
                                        t-on-click="openBaselineHistory">View Baseline History</button>
                            </div>
                            <div class="o_cp_planner_inspector_section mb-3">
                                <div class="fw-bold small text-uppercase text-muted o_cp_planner_dep_toggle"
                                     role="button" t-on-click="() => state.depOpen = !state.depOpen">
                                    <i class="fa fa-fw"
                                       t-att-class="state.depOpen ? 'fa-caret-down' : 'fa-caret-right'"/>
                                    Dependencies
                                </div>
                                <div t-if="state.depOpen" class="mt-2">
                                    <div class="mb-2">
                                        <div class="o_cp_planner_inspector_label mb-1">Predecessors</div>
                                        <div t-foreach="state.form?.depend_on_ids || []" t-as="depId" t-key="depId"
                                             class="o_cp_planner_dep_chip d-inline-flex align-items-center gap-1 me-1 mb-1">
                                            <span t-esc="taskLabel(depId)"/>
                                            <i class="fa fa-times" role="button" title="Remove"
                                               t-on-click="() => this.removePredecessor(depId)"/>
                                        </div>
                                        <select class="form-select form-select-sm"
                                                t-att-value="state.form?.addPredecessorId"
                                                t-on-change="addPredecessor">
                                            <option value="">Add predecessor…</option>
                                            <t t-foreach="state.tasks" t-as="cand" t-key="cand.id">
                                                <option t-if="cand.id !== state.inspector?.id &amp;&amp; !state.form?.depend_on_ids.includes(cand.id)"
                                                        t-att-value="cand.id" t-esc="taskLabel(cand.id)"/>
                                            </t>
                                        </select>
                                    </div>
                                    <div>
                                        <div class="o_cp_planner_inspector_label mb-1">Successors</div>
                                        <div t-foreach="state.form?.dependent_ids || []" t-as="depId" t-key="depId"
                                             class="o_cp_planner_dep_chip d-inline-flex align-items-center gap-1 me-1 mb-1">
                                            <span t-esc="taskLabel(depId)"/>
                                            <i class="fa fa-times" role="button" title="Remove"
                                               t-on-click="() => this.removeSuccessor(depId)"/>
                                        </div>
                                        <select class="form-select form-select-sm"
                                                t-att-value="state.form?.addSuccessorId"
                                                t-on-change="addSuccessor">
                                            <option value="">Add successor…</option>
                                            <t t-foreach="state.tasks" t-as="cand" t-key="cand.id">
                                                <option t-if="cand.id !== state.inspector?.id &amp;&amp; !state.form?.dependent_ids.includes(cand.id)"
                                                        t-att-value="cand.id" t-esc="taskLabel(cand.id)"/>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="o_cp_planner_inspector_section mb-3">
                                <div class="fw-bold small text-uppercase text-muted o_cp_planner_dep_toggle"
                                     role="button" t-on-click="toggleResources">
                                    <i class="fa fa-fw"
                                       t-att-class="state.resOpen ? 'fa-caret-down' : 'fa-caret-right'"/>
                                    Resources
                                </div>
                                <div t-if="state.resOpen" class="mt-2">
                                    <div t-if="state.resLoading" class="text-muted small">Loading…</div>
                                    <t t-else="">
                                        <div t-foreach="state.resData?.requirements || []" t-as="req" t-key="req.id"
                                             class="o_cp_planner_res_req mb-2">
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="fa fa-fw"
                                                   t-att-class="req.category === 'human' ? 'fa-user' : 'fa-wrench'"/>
                                                <span class="small fw-bold flex-grow-1 text-truncate"
                                                      t-esc="req.role_name"/>
                                                <span class="small text-muted"
                                                      t-esc="req.assigned_quantity + ' / ' + req.quantity"/>
                                                <i class="fa" t-att-class="resStatusIcon(req)"/>
                                                <i class="fa fa-pencil o_cp_planner_res_action" role="button"
                                                   title="Edit requirement"
                                                   t-on-click="() => this.openRequirementForm(req)"/>
                                                <i class="fa fa-times o_cp_planner_res_action" role="button"
                                                   title="Remove requirement"
                                                   t-on-click="() => this.deleteRequirement(req.id)"/>
                                            </div>
                                            <div class="text-muted small">
                                                <t t-if="req.planned_hours"><t t-esc="formatHours(req.planned_hours)"/> · </t>
                                                <t t-esc="formatDay(req.date_start)"/> – <t t-esc="formatDay(req.date_end)"/>
                                            </div>
                                            <div class="mt-1">
                                                <div t-foreach="req.assignments" t-as="asg" t-key="asg.id"
                                                     class="o_cp_planner_dep_chip d-inline-flex align-items-center gap-1 me-1 mb-1">
                                                    <span t-esc="asg.name"/>
                                                    <i class="fa fa-times" role="button" title="Unassign"
                                                       t-on-click="() => this.unassignResource(asg.id)"/>
                                                </div>
                                                <span class="small text-primary" role="button"
                                                      t-on-click="() => this.toggleAssignPicker(req)">+ Assign</span>
                                            </div>
                                            <div t-if="state.resAssignFor === req.id"
                                                 class="o_cp_planner_res_options border rounded mt-1">
                                                <div t-if="state.resOptionsLoading" class="text-muted small p-2">Loading…</div>
                                                <t t-else="" t-foreach="state.resOptions" t-as="opt"
                                                   t-key="opt.employee_id || opt.equipment_id">
                                                    <div class="o_cp_planner_res_option d-flex align-items-center gap-2 px-2 py-1"
                                                         role="button" t-att-title="opt.booking_summary"
                                                         t-on-click="() => this.assignResource(req, opt)">
                                                        <i class="fa fa-fw"
                                                           t-att-class="availabilityClass(opt.availability) + ' ' + (req.category === 'human' ? 'fa-user' : 'fa-wrench')"/>
                                                        <span class="small text-truncate flex-grow-1" t-esc="opt.name"/>
                                                        <i t-if="opt.availability !== 'fully_available'"
                                                           class="fa fa-exclamation-triangle text-warning"
                                                           title="Booked in this period"/>
                                                    </div>
                                                </t>
                                                <div t-if="!state.resOptionsLoading &amp;&amp; !state.resOptions.length"
                                                     class="text-muted small p-2 fst-italic">
                                                    No matching resources for this role.
                                                </div>
                                            </div>
                                        </div>
                                        <div t-if="!state.resData?.requirements?.length &amp;&amp; !state.resAddOpen"
                                             class="text-muted small fst-italic mb-1">
                                            No resource requirements for this task.
                                        </div>
                                        <span t-if="!state.resAddOpen" class="small text-primary" role="button"
                                              t-on-click="() => this.openRequirementForm()">+ Add Requirement</span>
                                        <div t-else="" class="o_cp_planner_res_form border rounded p-2 mt-2">
                                            <select class="form-select form-select-sm mb-1"
                                                    t-att-value="state.resForm.role_id"
                                                    t-on-change="(ev) => state.resForm.role_id = ev.target.value">
                                                <option value="">Resource role…</option>
                                                <t t-foreach="state.resData?.roles || []" t-as="role" t-key="role.id">
                                                    <option t-att-value="role.id"
                                                            t-esc="role.name + (role.category === 'equipment' ? ' (Equipment)' : '')"/>
                                                </t>
                                            </select>
                                            <div class="d-flex gap-1 mb-1">
                                                <input type="number" class="form-control form-control-sm"
                                                       placeholder="Qty" min="0" step="1"
                                                       t-att-value="state.resForm.quantity"
                                                       t-on-change="(ev) => state.resForm.quantity = ev.target.value"/>
                                                <input type="number" class="form-control form-control-sm"
                                                       placeholder="Planned hours" min="0" step="0.5"
                                                       t-att-value="state.resForm.planned_hours"
                                                       t-on-change="(ev) => state.resForm.planned_hours = ev.target.value"/>
                                            </div>
                                            <div class="d-flex gap-1 mb-1">
                                                <input type="date" class="form-control form-control-sm"
                                                       title="Start (defaults to task start)"
                                                       t-att-value="state.resForm.date_start"
                                                       t-on-change="(ev) => state.resForm.date_start = ev.target.value"/>
                                                <input type="date" class="form-control form-control-sm"
                                                       title="End (defaults to task finish)"
                                                       t-att-value="state.resForm.date_end"
                                                       t-on-change="(ev) => state.resForm.date_end = ev.target.value"/>
                                            </div>
                                            <input type="text" class="form-control form-control-sm mb-2"
                                                   placeholder="Description (optional)"
                                                   t-att-value="state.resForm.description"
                                                   t-on-change="(ev) => state.resForm.description = ev.target.value"/>
                                            <div class="d-flex gap-1">
                                                <button type="button" class="btn btn-primary btn-sm"
                                                        t-on-click="saveRequirement">Save</button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        t-on-click="() => { state.resAddOpen = false; state.resEditingId = null; }">Cancel</button>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="o_cp_planner_inspector_footer border-top px-3 py-2 d-flex gap-2">
                        <button type="button" class="btn btn-primary btn-sm"
                                t-att-disabled="state.saving"
                                t-on-click="saveInspector">
                            <t t-if="state.saving">Saving…</t>
                            <t t-else="">Save</t>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                t-on-click="openInspectorTask">Open Full Task</button>
                    </div>
                </div>
                <div t-if="state.historyOpen" class="o_cp_planner_history d-flex flex-column border-start">
                    <div class="o_cp_planner_inspector_header px-3 pt-3 pb-2 border-bottom d-flex align-items-center justify-content-between">
                        <span class="fw-bold">Baseline History</span>
                        <button type="button" class="btn-close btn-sm" t-on-click="toggleHistory"/>
                    </div>
                    <div class="flex-grow-1 overflow-auto px-3 py-2">
                        <div t-if="state.historyLoading" class="text-muted small py-2">Loading…</div>
                        <div t-elif="!state.historyList.length" class="text-muted small py-2 fst-italic">
                            No baselines exist for this project yet.
                        </div>
                        <div t-foreach="state.historyList" t-as="item" t-key="item.id"
                             class="o_cp_planner_history_item"
                             t-att-class="{selected: state.historyDetail?.id === item.id}"
                             t-on-click="() => this.selectBaselineVersion(item)">
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold" t-esc="item.name"/>
                                <span class="text-muted small" t-esc="formatHistoryDate(item.created_on)"/>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span t-esc="formatHours(item.project_duration)"/>
                                <span t-if="item.is_initial" class="text-muted fst-italic">Initial</span>
                                <span t-else="" class="text-muted"
                                      t-esc="formatSignedHours(item.duration_variance) + ' vs ' + item.previous_name"/>
                            </div>
                        </div>
                        <div t-if="state.historyDetailLoading" class="text-muted small py-2">Loading…</div>
                        <div t-if="state.historyDetail &amp;&amp; !state.historyDetailLoading"
                             class="o_cp_planner_history_detail border-top mt-3 pt-2">
                            <div class="fw-bold mb-2" t-esc="state.historyDetail.name"/>
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Project Duration</span>
                                <span t-esc="formatHours(state.historyDetail.project_duration)"/>
                            </div>
                            <div t-if="state.historyDetail.previous_name"
                                 class="d-flex justify-content-between small">
                                <span class="text-muted">Previous Baseline</span>
                                <span><t t-esc="formatHours(state.historyDetail.previous_duration)"/>
                                    (<t t-esc="state.historyDetail.previous_name"/>)</span>
                            </div>
                            <div t-if="!state.historyDetail.is_initial"
                                 class="d-flex justify-content-between small">
                                <span class="text-muted">Variance</span>
                                <span t-esc="formatSignedHours(state.historyDetail.duration_variance)"/>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Tasks Changed</span>
                                <span t-esc="state.historyDetail.tasks_changed"/>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Critical Path Changes</span>
                                <span t-esc="state.historyDetail.cp_changes"/>
                            </div>
                            <div t-if="state.historyDetail.is_initial"
                                 class="text-muted small fst-italic mt-2">
                                Initial baseline — <t t-esc="state.historyDetail.task_count"/> task snapshots.
                            </div>
                            <t t-else="">
                                <div class="fw-bold small text-uppercase text-muted mt-3 mb-1">Changes</div>
                                <div class="text-muted small mb-2 fst-italic">
                                    Gantt shows this baseline vs the current plan.
                                </div>
                                <div t-if="!state.historyDetail.changes.length"
                                     class="text-muted small fst-italic">
                                    No task changes in this baseline.
                                </div>
                                <div t-foreach="state.historyDetail.changes" t-as="change" t-key="change.task_id"
                                     class="o_cp_planner_history_change" role="button"
                                     t-on-click="() => this.openHistoryTask(change)">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-truncate" t-esc="change.task_name"/>
                                        <span t-if="change.delta_hours !== false" class="ms-2"
                                              t-att-class="change.delta_hours > 0 ? 'text-danger' : 'text-success'"
                                              t-esc="formatSignedHours(change.delta_hours)"/>
                                    </div>
                                    <div t-if="change.delta_hours !== false &amp;&amp; change.old_hours !== false"
                                         class="text-muted small"
                                         t-esc="formatHours(change.old_hours) + ' → ' + formatHours(change.new_hours)"/>
                                    <div class="small">
                                        <span t-if="change.entered_cp" class="badge text-bg-warning me-1">Entered Critical Path</span>
                                        <span t-if="change.left_cp" class="badge text-bg-secondary me-1">Left Critical Path</span>
                                        <span t-if="change.new_task" class="badge text-bg-info me-1">Added to plan</span>
                                        <span t-if="change.removed_task" class="badge text-bg-dark me-1">Removed from plan</span>
                                        <span t-if="change.delta_hours === 0 &amp;&amp; change.dates_changed"
                                              class="text-muted">Dates shifted</span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
            <div class="o_cp_planner_bottom border-top"/>
        </div>
    </t>
</templates>
