<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_supplier_documents" model="ir.ui.view">
        <field name="name">res.partner.form.supplier.documents</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action"
                        name="%(supplier_document_expiry.action_supplier_document)d"
                        context="{'search_default_partner_id': id, 'default_partner_id': id}"
                        groups="supplier_document_expiry.group_supplier_document_read"
                        icon="fa-file-text">
                    <field name="supplier_document_count" widget="statinfo" string="Belgeler"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page name="supplier_documents" string="Tedarikçi Belgeleri"
                      groups="supplier_document_expiry.group_supplier_document_read">
                    <field name="supplier_document_ids" nolabel="1"
                           context="{'default_partner_id': id}">
                        <list editable="bottom" string="Tedarikçi Belgeleri"
                              decoration-danger="status == 'red'"
                              decoration-warning="status == 'orange'">
                            <field name="name"/>
                            <field name="document_type_id"/>
                            <field name="responsible_user_id" widget="many2one_avatar_user"/>
                            <field name="validity_date"/>
                            <field name="remaining_days" optional="hide"/>
                            <field name="status" readonly="1"/>
                            <field name="attachment_ids" widget="many2many_tags"/>
                            <button type="action"
                                    name="%(supplier_document_expiry.action_supplier_document_open)d"
                                    icon="fa-external-link" title="Belgeyi Aç"/>
                            <field name="partner_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
