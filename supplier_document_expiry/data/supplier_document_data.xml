<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_type_document_expiry" model="mail.activity.type">
        <field name="name">Tedarikçi Belge Uyarısı</field>
        <field name="icon">fa-file-text</field>
        <field name="res_model">supplier.document</field>
        <field name="decoration_type">warning</field>
        <field name="summary">Tedarikçi belgesi geçerlilik uyarısı</field>
    </record>

    <!-- Örnek belge türleri; Belge Türleri menüsünden serbestçe
         değiştirilebilir veya silinebilir. -->
    <record id="document_type_license" model="supplier.document.type">
        <field name="sequence">10</field>
        <field name="name">Lisans</field>
        <field name="warning_days_yellow">30</field>
        <field name="warning_days_orange">7</field>
    </record>
    <record id="document_type_contract" model="supplier.document.type">
        <field name="sequence">20</field>
        <field name="name">Sözleşme</field>
        <field name="warning_days_yellow">20</field>
        <field name="warning_days_orange">5</field>
    </record>
    <record id="document_type_certificate" model="supplier.document.type">
        <field name="sequence">30</field>
        <field name="name">Sertifika</field>
        <field name="warning_days_yellow">60</field>
        <field name="warning_days_orange">15</field>
    </record>

    <!-- Ek satırındaki indir butonu; dosyayı doğrudan indirir. -->
    <record id="action_supplier_document_attachment_download" model="ir.actions.server">
        <field name="name">İndir</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_url',
    'url': '/web/content/ir.attachment/%s/datas?download=1' % records[:1].id,
    'target': 'self',
}</field>
    </record>

    <!-- Belgeler dialog'unda kullanılan kompakt ek listesi. -->
    <record id="view_supplier_document_attachment_list" model="ir.ui.view">
        <field name="name">ir.attachment.supplier.documents.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list string="Belgeler" create="0" edit="0">
                <field name="name"/>
                <field name="file_size"/>
                <button type="action"
                        name="%(supplier_document_expiry.action_supplier_document_attachment_download)d"
                        icon="fa-download" title="İndir"/>
            </list>
        </field>
    </record>

    <!-- Partner formundaki gömülü listede satırın ataç butonu; belgenin
         eklerini indirme ikonlu küçük liste dialog'unda açar. -->
    <record id="action_supplier_document_attachments" model="ir.actions.act_window">
        <field name="name">Belgeler</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list</field>
        <field name="domain">[('res_model', '=', 'supplier.document'), ('res_id', '=', active_id)]</field>
        <field name="context">{'default_res_model': 'supplier.document', 'default_res_id': active_id}</field>
        <field name="target">new</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('supplier_document_expiry.view_supplier_document_attachment_list')})]"/>
    </record>

    <!-- Günlük geçerlilik/durum kontrolü ve uyarı üretimi -->
    <record id="ir_cron_supplier_document_expiry" model="ir.cron">
        <field name="name">Tedarikçi Belgeleri: Geçerlilik Kontrolü</field>
        <field name="model_id" ref="model_supplier_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
