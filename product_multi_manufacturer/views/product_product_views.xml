<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_product_form_view_manufacturers" model="ir.ui.view">
        <field name="name">product.product.form.manufacturers</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="manufacturers" string="Üreticiler">
                    <field name="manufacturer_ids">
                        <list editable="bottom">
                            <field name="manufacturer_code"/>
                            <field name="manufacturer_id" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                            <field name="note" optional="hide"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
