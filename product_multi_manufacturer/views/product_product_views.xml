<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_search_form_view_manufacturers" model="ir.ui.view">
        <field name="name">product.product.search.manufacturers</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <field name="product_variant_ids" position="replace"/>
            <field name="name" position="after">
                <field name="manufacturer_ids" string="MPN"
                       filter_domain="[('manufacturer_ids.manufacturer_code', 'ilike', self)]"/>
            </field>
        </field>
    </record>

    <record id="product_product_form_view_manufacturers" model="ir.ui.view">
        <field name="name">product.product.form.manufacturers</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="manufacturers" string="Üretici | P/N">
                    <field name="manufacturer_ids">
                        <list editable="bottom">
                            <field name="manufacturer_code"/>
                            <field name="manufacturer_id" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                            <field name="note" optional="hide"/>
                            <field name="state"/>
                            <field name="attachment_ids" widget="mpn_attachments" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
