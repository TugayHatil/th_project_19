<odoo>
    <data>
        <record id="purchase_order_form_inherit_revision" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.revision</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="display_name" string="Reference" readonly="1"/>
                    <field name="revision_number" readonly="1" invisible="1"/>
                    <field name="was_confirmed" invisible="1"/>
                </xpath>
                <xpath expr="//button[@name='button_draft']" position="attributes">
                    <attribute name="invisible">state != 'cancel' or was_confirmed</attribute>
                </xpath>
                <xpath expr="//button[@name='button_draft']" position="after">
                    <button name="button_draft" invisible="state != 'cancel' or not was_confirmed" string="Revise" type="object" data-hotkey="o"/>
                </xpath>
                
            </field>
        </record>
    </data>
</odoo>
