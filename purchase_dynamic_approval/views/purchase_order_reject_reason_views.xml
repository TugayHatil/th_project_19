<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_reject_reason_list" model="ir.ui.view">
        <field name="name">purchase.order.reject.reason.list</field>
        <field name="model">purchase.order.reject.reason</field>
        <field name="arch" type="xml">
            <list string="Red Nedenleri" editable="bottom"
                  decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="purchase_order_reject_reason_form" model="ir.ui.view">
        <field name="name">purchase.order.reject.reason.form</field>
        <field name="model">purchase.order.reject.reason</field>
        <field name="arch" type="xml">
            <form string="Red Nedeni">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_order_reject_reason" model="ir.actions.act_window">
        <field name="name">Red Nedenleri</field>
        <field name="res_model">purchase.order.reject.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Henüz red nedeni tanımlanmadı.
            </p>
            <p>
                Satınalma siparişleri reddedilirken seçilebilecek
                nedenler burada tanımlanır.
            </p>
        </field>
    </record>
</odoo>
