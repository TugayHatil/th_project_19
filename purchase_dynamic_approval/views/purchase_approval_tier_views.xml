<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_approval_tier_list" model="ir.ui.view">
        <field name="name">purchase.approval.tier.list</field>
        <field name="model">purchase.approval.tier</field>
        <field name="arch" type="xml">
            <list string="Onay Baremleri" editable="bottom"
                  decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="amount_min"/>
                <field name="unlimited"/>
                <field name="amount_max" readonly="unlimited"/>
                <field name="approval_group_id"/>
                <field name="delegate_user_id"
                       domain="[('share', '=', False), ('all_group_ids', 'not in', approval_group_id)]"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="purchase_approval_tier_form" model="ir.ui.view">
        <field name="name">purchase.approval.tier.form</field>
        <field name="model">purchase.approval.tier</field>
        <field name="arch" type="xml">
            <form string="Onay Baremı">
                <sheet>
                    <group>
                        <group string="Tutar Aralığı">
                            <field name="sequence"/>
                            <field name="amount_min"/>
                            <field name="unlimited"/>
                            <field name="amount_max"
                                   readonly="unlimited"
                                   required="not unlimited"/>
                            <field name="active"/>
                        </group>
                        <group string="Onay Yetkisi">
                            <field name="approval_group_id"/>
                            <field name="delegate_user_id"
                                   domain="[('share', '=', False), ('all_group_ids', 'not in', approval_group_id)]"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_approval_tier_search" model="ir.ui.view">
        <field name="name">purchase.approval.tier.search</field>
        <field name="model">purchase.approval.tier</field>
        <field name="arch" type="xml">
            <search string="Onay Baremleri">
                <field name="approval_group_id"/>
                <filter name="inactive" string="Arşivlenmiş"
                        domain="[('active', '=', False)]"/>
                <filter name="group_company" string="Şirket"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_approval_tier" model="ir.actions.act_window">
        <field name="name">Onay Baremleri</field>
        <field name="res_model">purchase.approval.tier</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="purchase_approval_tier_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Henüz onay baremi tanımlanmadı.
            </p>
            <p>
                Tutar aralıkları ve her aralık için onaylayıcı kullanıcı
                grubu burada tanımlanır. Alt sınır dahil, üst sınır
                hariçtir; aralıklar çakışamaz.
            </p>
        </field>
    </record>
</odoo>
