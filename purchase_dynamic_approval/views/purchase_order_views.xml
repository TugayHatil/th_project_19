<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_dynamic_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.dynamic.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_approve']" position="attributes">
                <attribute name="invisible">state != 'to approve' or approval_required</attribute>
            </xpath>
            <xpath expr="//header/field[@name='lock_confirmed_po']" position="after">
                <field name="approval_required" invisible="1"/>
                <field name="can_approve" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="before">
                <button name="action_dynamic_approve" type="object"
                        string="Onayla" class="oe_highlight" data-hotkey="v"
                        invisible="state != 'to approve' or not approval_required or not can_approve"/>
                <button name="action_dynamic_reject" type="object"
                        string="Reddet"
                        invisible="state != 'to approve' or not approval_required or not can_approve"/>
                <button name="action_reset_to_draft" type="object"
                        string="Taslağa Al"
                        invisible="state != 'to approve' or not approval_required"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" role="alert"
                     invisible="state != 'to approve' or not approval_required">
                    <strong>Beklenen Onay:</strong>
                    <field name="approval_group_id" class="d-inline-block ms-1"/>
                    <strong class="ms-3">Onay Baremı:</strong>
                    <field name="approval_tier_id" class="d-inline-block ms-1"/>
                </div>
                <div class="alert alert-success" role="alert"
                     invisible="approval_state != 'approved'">
                    <strong>Onay Durumu: Onaylandı</strong>
                    <span class="ms-2">Onaylayan:</span>
                    <field name="approver_id" class="d-inline-block ms-1"/>
                    <field name="approve_date" class="d-inline-block ms-1"/>
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="approval_state != 'rejected'">
                    <strong>Onay Durumu: Reddedildi</strong>
                    <span class="ms-2">Reddeden:</span>
                    <field name="approver_id" class="d-inline-block ms-1"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="dynamic_approval" string="Onay"
                      invisible="not approval_required and approval_state == 'none'">
                    <group>
                        <group string="Onay Bilgileri">
                            <field name="approval_state"/>
                            <field name="approval_required"/>
                            <field name="approval_tier_id"/>
                            <field name="approval_group_id"/>
                            <field name="submitted_amount"/>
                        </group>
                        <group string="Karar Bilgileri">
                            <field name="approver_id"/>
                            <field name="approve_date"/>
                        </group>
                    </group>
                    <group string="Onay Geçmişi">
                        <field name="approval_history_ids" nolabel="1"
                               options="{'no_create': True}">
                            <list>
                                <field name="date"/>
                                <field name="action" widget="badge"/>
                                <field name="tier_id"/>
                                <field name="approval_group_id"/>
                                <field name="user_id"/>
                                <field name="amount_total"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="note" optional="show"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_inherit_dynamic_approval" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.dynamic.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="approval_group_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
