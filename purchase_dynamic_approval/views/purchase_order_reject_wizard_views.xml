<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.reject.wizard.form</field>
        <field name="model">purchase.order.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Siparişi Reddet">
                <group>
                    <field name="order_id"/>
                    <field name="reject_reason"
                           placeholder="Red nedenini yazınız..."
                           nolabel="1"/>
                </group>
                <footer>
                    <button name="action_reject" type="object"
                            string="Reddet" class="oe_highlight"/>
                    <button string="Vazgeç" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
